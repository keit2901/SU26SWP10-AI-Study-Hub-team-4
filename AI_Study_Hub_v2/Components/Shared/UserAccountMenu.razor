@code {
    private bool _open;
    private bool _planLoading;
    private bool _notificationsOpen;
    private bool _notificationsLoading;
    private string? _notificationError;
    private UserNotificationFeedDto? _notificationFeed;
    private Guid? _notificationUserId;
    private bool _notificationOperationBusy;
    private Guid? _openingNotificationId;
    private readonly CancellationTokenSource _notificationPollingCts = new();
    private PeriodicTimer? _notificationTimer;
    private Task? _notificationPollingTask;
    private bool _disposed;

    private IReadOnlyList<UserNotificationFeedItemDto> NotificationItems =>
        _notificationFeed?.Items ?? [];

    private int _unreadCount => _notificationFeed?.UnreadCount ?? 0;

    private string NotificationButtonLabel => _unreadCount > 0
        ? $"Notifications, {_unreadCount} unread"
        : "Notifications";

    protected override void OnInitialized()
    {
        Session.OnChange += OnSessionChanged;
        _notificationTimer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _notificationPollingTask = PollNotificationsAsync(_notificationPollingCts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (TryGetSupabaseUserId(out var currentUserId)
            && _notificationUserId != currentUserId
            && !_notificationOperationBusy)
        {
            await LoadNotificationsAsync(
                forceRefresh: false,
                cancellationToken: _notificationPollingCts.Token);
        }

        if (_planLoading
            || !Session.IsAuthenticated
            || Session.CurrentPlanSnapshot is not null)
        {
            return;
        }

        _planLoading = true;
        try
        {
            await Session.LoadCurrentPlanAsync(PlanApi);
        }
        catch
        {
        }
        finally
        {
            _planLoading = false;
        }
    }

    private string DisplayName =>
        Session.CurrentUser?.FullName
        ?? Session.CurrentUser?.Username
        ?? Session.CurrentUser?.Email
        ?? "Student";

    private string PlanLabel
    {
        get
        {
            var role = Session.CurrentUser?.Role;
            if (string.Equals(role, "Moderator", StringComparison.OrdinalIgnoreCase))
            {
                return "Moderator";
            }

            if (string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                return "Admin";
            }

            return Session.CurrentPlanDisplayName;
        }
    }

    private string FormatPlanClass()
    {
        var plan = Session.CurrentPlan?.ToLowerInvariant() ?? "free";
        return plan == "pro" ? "plan-pro" : "plan-free";
    }

    private string GetInitials()
    {
        var name = DisplayName;
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : name[..Math.Min(2, name.Length)].ToUpperInvariant();
    }

    private void ToggleMenu()
    {
        _notificationsOpen = false;
        _open = !_open;
    }

    private void CloseMenu() => _open = false;

    private void CloseNotifications() => _notificationsOpen = false;

    private void CloseAllMenus()
    {
        CloseMenu();
        CloseNotifications();
    }

    private void OnSessionChanged()
    {
        _ = HandleSessionChangedAsync();
    }

    private async Task HandleSessionChangedAsync()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (!TryGetSupabaseUserId(out var currentUserId)
                    || (_notificationUserId.HasValue && _notificationUserId != currentUserId))
                {
                    ResetNotificationState();
                }

                StateHasChanged();
            });

            if (Session.IsAuthenticated && !_notificationOperationBusy)
            {
                await LoadNotificationsAsync(
                    forceRefresh: true,
                    backgroundRefresh: true,
                    cancellationToken: _notificationPollingCts.Token);
            }
        }
        catch (OperationCanceledException) when (_notificationPollingCts.IsCancellationRequested)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
        catch
        {
            if (!_disposed)
            {
                _notificationError = "Notifications are unavailable right now.";
            }
        }
    }

    private async Task ToggleNotificationsAsync()
    {
        if (_notificationsOpen)
        {
            CloseNotifications();
            return;
        }

        CloseMenu();
        _notificationsOpen = true;
        StateHasChanged();
        await LoadNotificationsAsync(
            forceRefresh: true,
            backgroundRefresh: false,
            cancellationToken: _notificationPollingCts.Token);
    }

    private async Task LoadNotificationsAsync(
        bool forceRefresh,
        bool backgroundRefresh = false,
        CancellationToken cancellationToken = default)
    {
        if (_disposed
            || _notificationOperationBusy
            || !TryGetSupabaseUserId(out var requestedUserId))
        {
            return;
        }

        if (!forceRefresh
            && _notificationFeed is not null
            && _notificationUserId == requestedUserId)
        {
            return;
        }

        _notificationOperationBusy = true;
        _notificationsLoading = true;
        _notificationError = null;
        _notificationUserId = requestedUserId;
        try
        {
            var feed = await Notifications.GetMineAsync(requestedUserId, 10, cancellationToken);
            if (IsCurrentSession(requestedUserId))
            {
                _notificationFeed = feed;
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch
        {
            if (IsCurrentSession(requestedUserId) && (!backgroundRefresh || _notificationsOpen))
            {
                _notificationError = "Notifications are unavailable right now.";
            }
        }
        finally
        {
            _notificationsLoading = false;
            _notificationOperationBusy = false;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OpenNotificationAsync(UserNotificationFeedItemDto item)
    {
        if (_notificationOperationBusy) return;

        if (!TryGetSupabaseUserId(out var userId))
        {
            ResetNotificationState();
            return;
        }

        _notificationOperationBusy = true;
        _openingNotificationId = item.Id;
        MarkNotificationReadLocally(item.Id);
        await InvokeAsync(StateHasChanged);
        try
        {
            await Notifications.MarkReadAsync(userId, item.Id, _notificationPollingCts.Token);
        }
        catch (OperationCanceledException) when (_notificationPollingCts.IsCancellationRequested)
        {
        }
        catch (UserNotificationException ex) when (ex.Code == "notification_not_found")
        {
            if (IsCurrentSession(userId))
            {
                RemoveNotificationLocally(item.Id);
                _notificationError = "The notification could not be marked as read, but its folder outcomes are still available.";
                Snackbar.Add("Opened the result, but the notification was no longer available to mark as read.", Severity.Info);
            }
        }
        catch
        {
            if (IsCurrentSession(userId))
            {
                _notificationError = "Opened the result, but the read status could not be saved.";
                Snackbar.Add("Opened the result, but the notification read status could not be saved.", Severity.Info);
            }
        }
        finally
        {
            _notificationOperationBusy = false;
            _openingNotificationId = null;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }

        if (!_notificationPollingCts.IsCancellationRequested && IsCurrentSession(userId))
        {
            CloseNotifications();
            Nav.NavigateTo($"/share-review/{item.FolderId}");
        }
    }

    private void MarkNotificationReadLocally(Guid notificationId)
    {
        if (_notificationFeed is null) return;

        var wasUnread = _notificationFeed.Items.Any(item => item.Id == notificationId && item.ReadAt is null);
        var items = _notificationFeed.Items
            .Select(item => item.Id == notificationId ? item with { ReadAt = DateTimeOffset.UtcNow } : item)
            .ToList();
        _notificationFeed = new UserNotificationFeedDto(
            items,
            wasUnread ? Math.Max(0, _notificationFeed.UnreadCount - 1) : _notificationFeed.UnreadCount);
    }

    private void RemoveNotificationLocally(Guid notificationId)
    {
        if (_notificationFeed is null) return;

        var removedUnread = _notificationFeed.Items.Any(item => item.Id == notificationId && item.ReadAt is null);
        _notificationFeed = new UserNotificationFeedDto(
            _notificationFeed.Items.Where(item => item.Id != notificationId).ToList(),
            removedUnread ? Math.Max(0, _notificationFeed.UnreadCount - 1) : _notificationFeed.UnreadCount);
    }

    private bool IsCurrentSession(Guid userId) =>
        !_disposed
        && TryGetSupabaseUserId(out var currentUserId)
        && currentUserId == userId;

    private bool TryGetSupabaseUserId(out Guid userId)
    {
        userId = Guid.Empty;
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken)) return false;

        try
        {
            var token = new JwtSecurityTokenHandler().ReadJwtToken(Session.AccessToken);
            var subject = token.Claims.FirstOrDefault(claim => claim.Type is "sub" or ClaimTypes.NameIdentifier)?.Value;
            return Guid.TryParse(subject, out userId);
        }
        catch
        {
            return false;
        }
    }

    private void ResetNotificationState()
    {
        _notificationsOpen = false;
        _notificationError = null;
        _notificationFeed = null;
        _notificationUserId = null;
    }

    private async Task PollNotificationsAsync(CancellationToken cancellationToken)
    {
        if (_notificationTimer is null) return;

        try
        {
            while (await _notificationTimer.WaitForNextTickAsync(cancellationToken))
            {
                if (_disposed || !Session.IsAuthenticated || _notificationOperationBusy) continue;
                await InvokeAsync(() => LoadNotificationsAsync(
                    forceRefresh: true,
                    backgroundRefresh: true,
                    cancellationToken: cancellationToken));
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (ObjectDisposedException) when (_disposed)
        {
        }
    }

    private string FormatUnreadCount() => _unreadCount > 9 ? "9+" : _unreadCount.ToString();

    private static string GetNotificationOutcomeClass(UserNotificationFeedItemDto item) =>
        item.Outcome.ToString() switch
        {
            "Approved" => "is-approved",
            "Mixed" => "is-mixed",
            _ => "is-rejected"
        };

    private static string GetNotificationIcon(UserNotificationFeedItemDto item) =>
        item.Outcome.ToString() switch
        {
            "Approved" => Icons.Material.Filled.CheckCircle,
            "Mixed" => Icons.Material.Filled.CallSplit,
            _ => Icons.Material.Filled.Cancel
        };

    private static string GetNotificationTitle(UserNotificationFeedItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Title)) return item.Title;

        var action = item.Outcome.ToString() switch
        {
            "Approved" => "approved",
            "Rejected" => "rejected",
            "Mixed" => "completed with mixed results",
            _ => "completed"
        };

        return item.Kind.ToString() switch
        {
            "DocumentModerationFinal" => $"File moderation {action}",
            "EscalationResolved" => "Escalation review completed",
            _ => $"Sharing review {action}"
        };
    }

    private static string GetNotificationMessage(UserNotificationFeedItemDto item)
    {
        if (!string.IsNullOrWhiteSpace(item.Message)) return item.Message;

        var subject = GetNotificationDocumentId(item).HasValue ? "This file" : $"{item.FolderName}";
        return item.Outcome.ToString() switch
        {
            "Approved" => $"{subject} was approved and is public.",
            "Mixed" => $"{subject} has mixed outcomes. Approved files remain public; other files stay private.",
            _ => $"{subject} was rejected and remains private."
        };
    }

    private static Guid? GetNotificationDocumentId(UserNotificationFeedItemDto item) => item.DocumentId;

    private static string GetNotificationSource(UserNotificationFeedItemDto item) =>
        item.Kind.ToString() == "EscalationResolved" ? "Admin escalation" : "Moderation result";

    private static string GetNotificationOutcomeLabel(UserNotificationFeedItemDto item) =>
        item.Outcome.ToString() switch
        {
            "Approved" => "Approved",
            "Mixed" => "Mixed results",
            _ => "Rejected"
        };

    private static string FormatNotificationTime(DateTimeOffset createdAt) =>
        createdAt.ToLocalTime().ToString("MMM d, h:mm tt");

    private async Task OpenProfileDialogAsync()
    {
        CloseMenu();
        await DialogService.ShowAsync<StudentProfileDialog>("Profile", BuildDialogOptions());
    }

    private async Task OpenPaymentHistoryDialogAsync()
    {
        CloseMenu();
        await DialogService.ShowAsync<StudentPaymentHistoryDialog>("Payment history", BuildDialogOptions());
    }

    private async Task OpenTransactionDetailAsync()
    {
        CloseMenu();
        await DialogService.ShowAsync<StudentPaymentHistoryDialog>("Transaction details", BuildDialogOptions());
    }

    private void GoToPricing()
    {
        CloseMenu();
        Nav.NavigateTo("/pricing");
    }

    private DialogOptions BuildDialogOptions() => new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
        BackdropClick = true,
        NoHeader = true,
        BackgroundClass = "student-quick-dialog-backdrop"
    };

    private async Task LogoutAsync()
    {
        CloseMenu();
        _notificationPollingCts.Cancel();
        await AuthPersistence.ClearAsync();
        Session.Clear();
        Nav.NavigateTo("/login", replace: true);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Session.OnChange -= OnSessionChanged;
        _notificationPollingCts.Cancel();
        _notificationTimer?.Dispose();
        if (_notificationPollingTask is not null)
        {
            try
            {
                await _notificationPollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _notificationPollingCts.Dispose();
    }
}
