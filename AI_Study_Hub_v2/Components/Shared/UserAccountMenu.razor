@inject AI_Study_Hub_v2.Services.AuthSessionState Session
@inject AI_Study_Hub_v2.Services.AuthPersistenceService AuthPersistence
@inject AI_Study_Hub_v2.Services.PlanApiClient PlanApi
@inject AI_Study_Hub_v2.Services.IUserNotificationService Notifications
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using AI_Study_Hub_v2.Components.Pages
@using AI_Study_Hub_v2.Data.Entities
@using AI_Study_Hub_v2.Dtos
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims
@implements IAsyncDisposable

@if (Session.IsAuthenticated)
{
    <div class="uam-wrapper">
        <button type="button"
                class="uam-notification-btn"
                title="@NotificationButtonLabel"
                aria-label="@NotificationButtonLabel"
                aria-haspopup="true"
                aria-expanded="@_notificationsOpen"
                @onclick="ToggleNotificationsAsync">
            <MudIcon Icon="@(_notificationsOpen ? Icons.Material.Filled.Notifications : Icons.Material.Filled.NotificationsNone)" Size="Size.Small" />
            @if (_unreadCount > 0)
            {
                <span class="uam-notification-badge" aria-hidden="true">@FormatUnreadCount()</span>
            }
        </button>

        <button type="button"
                class="uam-trigger-btn"
                aria-label="Open account menu"
                aria-haspopup="true"
                aria-expanded="@_open"
                @onclick="ToggleMenu">
            <div class="uam-trigger-avatar" title="@DisplayName">
                <span class="user-avatar-initials">@GetInitials()</span>
            </div>
            <div class="uam-user-meta d-none d-md-flex flex-column">
                <span class="uam-user-plan @FormatPlanClass()">@PlanLabel</span>
            </div>
        </button>

        @if (_open || _notificationsOpen)
        {
            <div class="uam-backdrop" @onclick="CloseAllMenus"></div>
        }

        @if (_notificationsOpen)
        {
            <div class="uam-popup uam-notifications-popup" role="region" aria-label="Notifications">
                <div class="uam-notifications-header">
                    <div>
                        <strong>Notifications</strong>
                        @if (_unreadCount > 0)
                        {
                            <span>@_unreadCount unread</span>
                        }
                    </div>
                    @if (_notificationsLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" aria-label="Loading notifications" />
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_notificationError))
                {
                    <div class="uam-notification-alert" role="status">
                        @_notificationError
                    </div>
                }

                @if (_notificationsLoading && _notificationFeed is null)
                {
                    <div class="uam-notification-state" role="status">Loading notifications…</div>
                }
                else if (NotificationItems.Count == 0)
                {
                    <div class="uam-notification-state">
                        <MudIcon Icon="@Icons.Material.Filled.NotificationsNone" Size="Size.Medium" />
                        <span>No notifications yet.</span>
                    </div>
                }
                else
                {
                    <div class="uam-notification-list">
                        @foreach (var item in NotificationItems)
                        {
                            var isUnread = item.ReadAt is null;
                            <button type="button"
                                    class="uam-notification-item @(isUnread ? "is-unread" : null)"
                                    aria-label="@($"{GetNotificationTitle(item)}. {GetNotificationMessage(item)}")"
                                    disabled="@_notificationOperationBusy"
                                    @onclick="() => OpenNotificationAsync(item)">
                                <span class="uam-notification-icon @GetNotificationOutcomeClass(item)">
                                    <MudIcon Icon="@GetNotificationIcon(item)" Size="Size.Small" />
                                </span>
                                <span class="uam-notification-copy">
                                    <span class="uam-notification-title">@GetNotificationTitle(item)</span>
                                    <span class="uam-notification-message">@GetNotificationMessage(item)</span>
                                    <span class="uam-notification-meta">
                                        <span class="uam-notification-context">@GetNotificationSource(item)</span>
                                        <span class="uam-notification-outcome @GetNotificationOutcomeClass(item)">@GetNotificationOutcomeLabel(item)</span>
                                    </span>
                                    <span class="uam-notification-link">
                                        @(_openingNotificationId == item.Id ? "Opening…" : "View file outcomes")
                                        @if (_openingNotificationId != item.Id)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                                        }
                                    </span>
                                    <span class="uam-notification-time">@FormatNotificationTime(item.CreatedAt)</span>
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @if (_open)
        {
            <div class="uam-popup">
                <button class="uam-item" @onclick="OpenProfileDialogAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                    <span>Profile</span>
                </button>

                <button class="uam-item" @onclick="OpenPaymentHistoryDialogAsync">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                    <span>Payment history</span>
                </button>

                <button class="uam-item" @onclick="GoToPricing">
                    <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Size="Size.Small" />
                    <span>Upgrade plan</span>
                </button>
                <div class="uam-divider"></div>
                <button class="uam-item uam-item--danger" @onclick="LogoutAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                    <span>Logout</span>
                </button>
            </div>
        }
    </div>
}

<style>
