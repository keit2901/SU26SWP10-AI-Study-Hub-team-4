@namespace AI_Study_Hub_v2.Components.Shared

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">@DialogTitle</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Item: <strong>@ItemName</strong>
            </MudText>
            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="Reject reason"
                          Placeholder="Explain why this item is being rejected"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="4"
                          Immediate="true"
                          Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">Reject</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string DialogTitle { get; set; } = "Reject Item";

    [Parameter] public string ItemName { get; set; } = string.Empty;

    private string? _reason;

    private void Confirm()
    {
        var reason = _reason?.Trim();
        if (string.IsNullOrWhiteSpace(reason))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(reason));
    }

    private void Cancel() => MudDialog.Cancel();
}
