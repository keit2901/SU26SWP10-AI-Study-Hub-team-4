@namespace AI_Study_Hub_v2.Components.Shared
@using AI_Study_Hub_v2.Data.Entities

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">Send Feedback</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Folder: <strong>@FolderName</strong>
            </MudText>
            @if (FailCount > 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Failed reviews: <strong>@FailCount</strong>
                </MudText>
            }
            @if (!string.IsNullOrWhiteSpace(LatestReason))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                    Latest review feedback: @LatestReason
                </MudAlert>
            }
            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="Reason"
                          Placeholder="Why should this folder be reviewed again?"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true" />
            <MudTextField T="string"
                          @bind-Value="_description"
                          Label="Description"
                          Placeholder="Describe what you changed or what the moderator should know"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="4"
                          Immediate="true"
                          Required="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">
            Send feedback
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string FolderName { get; set; } = string.Empty;

    [Parameter] public int FailCount { get; set; }

    [Parameter] public string? LatestReason { get; set; }

    private string? _reason;

    private string? _description;

    private void Confirm()
    {
        var reason = _reason?.Trim();
        var description = _description?.Trim();
        if (string.IsNullOrWhiteSpace(reason) || string.IsNullOrWhiteSpace(description))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new AppealFolderShareDialogResult
        {
            Reason = reason,
            Description = description
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed class AppealFolderShareDialogResult
    {
        public string Reason { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;
    }
}
