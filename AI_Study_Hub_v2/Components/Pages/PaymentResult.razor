@page "/payment/result"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject PlanApiClient PlanApi
@inject AuthSessionState Session
@inject AuthPersistenceService AuthPersistence
@using AI_Study_Hub_v2.Services

<PageTitle>Payment Result — AI Study Hub</PageTitle>

<div class="payment-result-page">
    <div class="result-orb result-orb-primary" aria-hidden="true"></div>
    <div class="result-orb result-orb-secondary" aria-hidden="true"></div>

    <main class="result-card" aria-live="polite" aria-busy="@_checking.ToString().ToLowerInvariant()">
        <div class="result-eyebrow">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
            <span>Secure payment confirmation</span>
        </div>

        @if (_view == PaymentResultView.Checking)
        {
            <div class="result-visual checking-visual" role="status">
                <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
            </div>
            <h1 class="result-title">Checking your payment</h1>
            <p class="result-subtitle">@GetCheckingMessage()</p>
            <p class="result-note">This page uses your account and PayOS records to confirm the final result.</p>
        }
        else
        {
            <div class="result-visual @($"{GetTone()}-visual")" aria-hidden="true">
                <MudIcon Icon="@GetIcon()" Size="Size.Large" />
            </div>
            <h1 class="result-title @($"{GetTone()}-text")">@GetTitle()</h1>
            <p class="result-subtitle">@GetMessage()</p>

            @if (_view == PaymentResultView.Completed && _result?.AmountVnd > 0)
            {
                <div class="result-amount" aria-label="Payment amount">
                    <span>Confirmed amount</span>
                    <strong>@_result.AmountVnd.ToString("N0")₫</strong>
                </div>
            }

            <div class="result-actions">
                @if (_view == PaymentResultView.SignInRequired)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@_loginUrl" Class="result-button">
                        Sign in securely
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/pricing" Class="result-button">
                        Back to pricing
                    </MudButton>
                }
                else if (_view == PaymentResultView.Completed)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GoToDashboard" Class="result-button">
                        Go to dashboard
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/profile" Class="result-button">
                        View profile
                    </MudButton>
                }
                else
                {
                    @if (CanCheckAgain())
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_checking"
                                   OnClick="CheckAgainAsync" Class="result-button">
                            @if (_checking)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="button-spinner" />
                                <span>Checking…</span>
                            }
                            else
                            {
                                <span>Check again</span>
                            }
                        </MudButton>
                    }

                    <MudButton Variant="@(CanCheckAgain() ? Variant.Outlined : Variant.Filled)"
                               Color="Color.Primary" Href="/pricing" Class="result-button">
                        @(_view is PaymentResultView.InvalidLink or PaymentResultView.NotFound ? "View plans" : "Back to pricing")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="GoToDashboard" Class="result-button">
                        Dashboard
                    </MudButton>
                }
            </div>
        }
    </main>
</div>

@code {
    private const long MaxPayOsOrderCode = 9_007_199_254_740_991;
    private static readonly TimeSpan ReconcileTimeout = TimeSpan.FromSeconds(20);

    private readonly CancellationTokenSource _lifetimeCts = new();
    private PaymentResultView _view = PaymentResultView.Checking;
    private ReturnUrlResult? _result;
    private long? _orderCode;
    private string? _loginUrl;
    private string? _providerStatusHint;
    private bool _cancelHint;
    private bool _checking;
    private bool _interactiveLoadStarted;
    private bool _disposed;

    protected override void OnInitialized()
    {
        if (!TryReadOrderCode(out var orderCode))
        {
            _view = PaymentResultView.InvalidLink;
            return;
        }

        _orderCode = orderCode;
        _loginUrl = BuildLoginUrl(orderCode);
        ReadDisplayHints();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _interactiveLoadStarted || _orderCode is null)
        {
            return;
        }

        _interactiveLoadStarted = true;
        await RestoreAndReconcileAsync();
    }

    private async Task RestoreAndReconcileAsync()
    {
        try
        {
            if (!Session.IsAuthenticated)
            {
                var restored = await AuthPersistence.TryRestoreAsync();
                if (restored is not null && !string.IsNullOrWhiteSpace(restored.AccessToken))
                {
                    Session.Set(restored);
                }
            }

            if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                _view = PaymentResultView.SignInRequired;
                await SafeRefreshAsync();
                return;
            }

            await ReconcileAsync(showPageLoader: true);
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            // The circuit was disposed or the user navigated away.
        }
    }

    private async Task ReconcileAsync(bool showPageLoader)
    {
        if (_checking || _orderCode is null || _disposed)
        {
            return;
        }

        var accessToken = Session.AccessToken;
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(accessToken))
        {
            _view = PaymentResultView.SignInRequired;
            await SafeRefreshAsync();
            return;
        }

        _checking = true;
        if (showPageLoader)
        {
            _view = PaymentResultView.Checking;
        }
        await SafeRefreshAsync();

        using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        timeoutCts.CancelAfter(ReconcileTimeout);

        try
        {
            _result = await PlanApi.ReconcilePaymentAsync(
                accessToken: accessToken,
                orderCode: _orderCode.Value,
                ct: timeoutCts.Token);
            _view = ResolveAuthoritativeView(_result);
        }
        catch (PlanApiException ex) when (ex.StatusCode is 401)
        {
            _view = PaymentResultView.SignInRequired;
        }
        catch (PlanApiException ex) when (ex.StatusCode is 403 or 404)
        {
            _view = PaymentResultView.NotFound;
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            return;
        }
        catch (OperationCanceledException)
        {
            _view = PaymentResultView.Unavailable;
        }
        catch
        {
            _view = PaymentResultView.Unavailable;
        }
        finally
        {
            _checking = false;
            await SafeRefreshAsync();
        }
    }

    private Task CheckAgainAsync() => ReconcileAsync(showPageLoader: false);

    private PaymentResultView ResolveAuthoritativeView(ReturnUrlResult result)
    {
        if (!result.IsValid)
        {
            return PaymentResultView.Unavailable;
        }

        return result.Status?.Trim().ToLowerInvariant() switch
        {
            "completed" or "demo_completed" => PaymentResultView.Completed,
            "cancelled" => PaymentResultView.Cancelled,
            "expired" => PaymentResultView.Expired,
            "failed" => PaymentResultView.Failed,
            "pending" => ResolvePendingView(result.ProviderStatus),
            _ => PaymentResultView.Unavailable
        };
    }

    private static PaymentResultView ResolvePendingView(string? providerStatus) =>
        providerStatus?.Trim().ToUpperInvariant() switch
        {
            "PROCESSING" => PaymentResultView.Processing,
            "UNDERPAID" => PaymentResultView.Underpaid,
            _ => PaymentResultView.Pending
        };

    private bool TryReadOrderCode(out long orderCode)
    {
        orderCode = 0;
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        var values = query.GetValues("orderCode");
        if (values is null)
        {
            return false;
        }

        long? accepted = null;
        foreach (var rawValue in values)
        {
            if (string.IsNullOrWhiteSpace(rawValue))
            {
                continue;
            }

            if (!long.TryParse(
                    rawValue,
                    System.Globalization.NumberStyles.None,
                    System.Globalization.CultureInfo.InvariantCulture,
                    out var parsed)
                || parsed <= 0
                || parsed > MaxPayOsOrderCode
                || (accepted.HasValue && accepted.Value != parsed))
            {
                return false;
            }

            accepted = parsed;
        }

        if (!accepted.HasValue)
        {
            return false;
        }

        orderCode = accepted.Value;
        return true;
    }

    private void ReadDisplayHints()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Navigation.Uri).Query);
        _cancelHint = query.GetValues("cancel")?
            .Any(value => bool.TryParse(value, out var parsed) && parsed) == true;
        _providerStatusHint = query.GetValues("status")?
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value))?
            .Trim()
            .ToUpperInvariant();
    }

    private string GetCheckingMessage()
    {
        if (_cancelHint)
        {
            return "PayOS redirected you after cancellation; confirming the final status…";
        }

        return _providerStatusHint switch
        {
            "PAID" => "PayOS redirected you after payment; confirming activation with your account…",
            "CANCELLED" => "PayOS redirected you after cancellation; confirming the final status…",
            "PENDING" or "PROCESSING" => "PayOS is still processing the checkout; confirming the current status…",
            _ => "Confirming the final payment status with your account…"
        };
    }

    private string GetCompletedMessage()
    {
        if (!string.IsNullOrWhiteSpace(_result?.PlanDisplayName))
        {
            return $"Your payment was confirmed and the {_result.PlanDisplayName} plan is active on your account.";
        }

        return "Your payment was confirmed and the purchased plan is active on your account.";
    }

    private static string BuildLoginUrl(long orderCode)
    {
        var canonicalReturnUrl = $"/payment/result?orderCode={orderCode}";
        return $"/login?returnUrl={Uri.EscapeDataString(canonicalReturnUrl)}";
    }

    private async Task SafeRefreshAsync()
    {
        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoToDashboard() => Navigation.NavigateTo(
        AdminAccessPolicy.GetAuthenticatedLandingPage(Session.CurrentUser?.Role),
        forceLoad: true);

    private bool CanCheckAgain() => _view is
        PaymentResultView.Failed
        or PaymentResultView.Pending
        or PaymentResultView.Processing
        or PaymentResultView.Underpaid
        or PaymentResultView.Unavailable;

    private string GetTone() => _view switch
    {
        PaymentResultView.Completed => "success",
        PaymentResultView.Failed or PaymentResultView.InvalidLink => "danger",
        PaymentResultView.Pending or PaymentResultView.Underpaid or PaymentResultView.Expired => "warning",
        PaymentResultView.SignInRequired or PaymentResultView.Processing or PaymentResultView.Unavailable => "info",
        _ => "neutral"
    };

    private string GetIcon() => _view switch
    {
        PaymentResultView.InvalidLink => Icons.Material.Filled.LinkOff,
        PaymentResultView.SignInRequired => Icons.Material.Filled.LockPerson,
        PaymentResultView.Completed => Icons.Material.Filled.CheckCircle,
        PaymentResultView.Cancelled => Icons.Material.Filled.Cancel,
        PaymentResultView.Expired => Icons.Material.Filled.TimerOff,
        PaymentResultView.Failed => Icons.Material.Filled.GppBad,
        PaymentResultView.Processing => Icons.Material.Filled.Sync,
        PaymentResultView.Underpaid => Icons.Material.Filled.AccountBalanceWallet,
        PaymentResultView.Pending => Icons.Material.Filled.HourglassTop,
        PaymentResultView.NotFound => Icons.Material.Filled.ReceiptLong,
        _ => Icons.Material.Filled.CloudOff
    };

    private string GetTitle() => _view switch
    {
        PaymentResultView.InvalidLink => "Invalid payment return link",
        PaymentResultView.SignInRequired => "Sign in required",
        PaymentResultView.Completed => "Payment confirmed",
        PaymentResultView.Cancelled => "Payment cancelled",
        PaymentResultView.Expired => "Payment link expired",
        PaymentResultView.Failed => "Payment could not be completed",
        PaymentResultView.Processing => "Payment is processing",
        PaymentResultView.Underpaid => "Payment needs attention",
        PaymentResultView.Pending => "Confirmation pending",
        PaymentResultView.NotFound => "Payment result unavailable",
        _ => "Confirmation temporarily unavailable"
    };

    private string GetMessage() => _view switch
    {
        PaymentResultView.InvalidLink => "This link is missing a valid payment reference. Return to pricing and open your payment from there.",
        PaymentResultView.SignInRequired => "Sign in to view your payment result.",
        PaymentResultView.Completed => GetCompletedMessage(),
        PaymentResultView.Cancelled => "PayOS confirmed that this payment was cancelled. Your plan was not changed.",
        PaymentResultView.Expired => "PayOS confirmed that the payment window expired before completion. You can start a new checkout from pricing.",
        PaymentResultView.Failed => "We could not safely complete this payment or activate the plan. If money left your account, contact support before trying again.",
        PaymentResultView.Processing => "PayOS is still processing this payment. Your plan will only change after the payment is confirmed.",
        PaymentResultView.Underpaid => "PayOS reports that the received amount does not yet match the checkout amount. Please review the payment in your banking app and check again later.",
        PaymentResultView.Pending => "The payment is not final yet. Your plan has not been changed while confirmation is pending.",
        PaymentResultView.NotFound => "We could not find a payment for this account and return link. Check that you signed in with the account used at checkout.",
        _ => "We could not reach the payment service or confirm the final status. Your plan has not been changed by this page."
    };

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();
        return ValueTask.CompletedTask;
    }

    private enum PaymentResultView
    {
        Checking,
        InvalidLink,
        SignInRequired,
        Completed,
        Cancelled,
        Expired,
        Failed,
        Pending,
        Processing,
        Underpaid,
        Unavailable,
        NotFound
    }
}

<style>
    .payment-result-page {
        position: relative;
        isolation: isolate;
        display: grid;
        place-items: center;
        min-height: min(82vh, 760px);
        padding: clamp(1rem, 4vw, 3rem);
        overflow: hidden;
    }

    .result-orb {
        position: absolute;
        z-index: -1;
        width: 22rem;
        height: 22rem;
        border-radius: 50%;
        filter: blur(72px);
        opacity: .22;
        pointer-events: none;
    }

    .result-orb-primary {
        top: 2%;
        left: 10%;
        background: #7c3aed;
    }

    .result-orb-secondary {
        right: 8%;
        bottom: 4%;
        background: #06b6d4;
    }

    .result-card {
        width: min(100%, 34rem);
        padding: clamp(1.5rem, 5vw, 3rem);
        text-align: center;
        color: #e8edf7;
        background:
            linear-gradient(145deg, rgba(21, 20, 40, .94), rgba(10, 15, 30, .88)) padding-box,
            linear-gradient(135deg, rgba(167, 139, 250, .4), rgba(34, 211, 238, .18), rgba(255, 255, 255, .08)) border-box;
        border: 1px solid transparent;
        border-radius: 1.5rem;
        box-shadow: 0 28px 80px rgba(2, 6, 23, .52);
        backdrop-filter: blur(18px);
    }

    .result-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        margin-bottom: 1.75rem;
        color: #a5b4fc;
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
    }

    .result-visual {
        display: grid;
        place-items: center;
        width: 5.25rem;
        height: 5.25rem;
        margin: 0 auto 1.25rem;
        border: 1px solid currentColor;
        border-radius: 50%;
    }

    .result-visual .mud-icon-root { font-size: 3rem; }
    .checking-visual { color: #a78bfa; background: rgba(124, 58, 237, .13); }
    .success-visual { color: #34d399; background: rgba(16, 185, 129, .12); }
    .danger-visual, .invalid-visual { color: #fb7185; background: rgba(244, 63, 94, .11); }
    .warning-visual { color: #fbbf24; background: rgba(245, 158, 11, .11); }
    .info-visual { color: #67e8f9; background: rgba(6, 182, 212, .11); }
    .neutral-visual { color: #cbd5e1; background: rgba(148, 163, 184, .1); }

    .result-title {
        margin: 0 0 .75rem;
        color: #f8fafc;
        font-size: clamp(1.55rem, 5vw, 2rem);
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -.025em;
    }

    .success-text { color: #6ee7b7; }
    .danger-text, .invalid-text { color: #fda4af; }
    .warning-text { color: #fde68a; }
    .info-text { color: #a5f3fc; }

    .result-subtitle,
    .result-note {
        max-width: 29rem;
        margin: 0 auto;
        color: #a9b5c9;
        font-size: .98rem;
        line-height: 1.65;
    }

    .result-note {
        margin-top: .75rem;
        color: #718096;
        font-size: .82rem;
    }

    .result-amount {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin: 1.5rem auto 0;
        padding: .9rem 1rem;
        color: #9ba9bd;
        background: rgba(15, 23, 42, .64);
        border: 1px solid rgba(148, 163, 184, .14);
        border-radius: .9rem;
        font-size: .84rem;
    }

    .result-amount strong {
        color: #6ee7b7;
        font-size: 1.35rem;
        letter-spacing: -.02em;
    }

    .result-actions {
        display: flex;
        justify-content: center;
        gap: .75rem;
        flex-wrap: wrap;
        margin-top: 1.75rem;
    }

    .result-actions .result-button {
        min-height: 2.75rem;
        border-radius: .75rem;
        font-weight: 700;
        text-transform: none;
    }

    .result-actions .button-spinner {
        margin-right: .5rem;
    }

    @@media (max-width: 520px) {
        .payment-result-page {
            min-height: calc(100vh - 5rem);
            padding: 1rem;
        }

        .result-card {
            padding: 1.5rem 1.1rem;
            border-radius: 1.15rem;
        }

        .result-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .result-actions .result-button { width: 100%; }
    }

    @@media (prefers-reduced-motion: no-preference) {
        .result-card { animation: result-card-in .45s ease-out both; }

        @@keyframes result-card-in {
            from { opacity: 0; transform: translateY(12px) scale(.985); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    }
</style>
