@namespace AI_Study_Hub_v2.Components.Pages
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using AI_Study_Hub_v2.Dtos
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Resubmit non-approved files?</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Review the rejected files in "@FolderName" and upload corrected copies before resubmitting when needed.
            </MudAlert>
            <MudStack Spacing="2">
                <MudText Typo="Typo.body2">
                    Non-approved files return to the moderator queue in a new review cycle. Approved files remain public and unchanged.
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Any unfinished Admin escalations are closed as superseded. Their history remains available for audit.
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Resubmitting does not replace file contents or delete rejected files.
                </MudText>
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Submit">
            Resubmit non-approved files
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string FolderName { get; set; } = string.Empty;

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok("Resubmit"));
}
