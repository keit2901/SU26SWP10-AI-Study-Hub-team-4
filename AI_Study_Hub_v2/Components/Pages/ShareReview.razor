@page "/share-review/{FolderId:guid}"
@using AI_Study_Hub_v2.Components.Pages.Dashboard
@using AI_Study_Hub_v2.Components.Shared
@using AI_Study_Hub_v2.Data.Entities
@using AI_Study_Hub_v2.Dtos
@using AI_Study_Hub_v2.Services
@using Microsoft.AspNetCore.Components
@using MudBlazor
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthSessionState Session
@inject FolderApiClient FoldersApi
@inject DocumentApiClient DocumentsApi
@inject AdminDashboardApiClient DashboardApi
@inject EscalationApiClient EscalationApi
@inject IDialogService DialogService

<PageTitle>Share Review — AI Study Hub</PageTitle>

<div class="share-review-page">
    @if (_isLoading)
    {
        <MudStack Spacing="3" Class="page-enter review-shell">
            <MudSkeleton Height="120px" Animation="Animation.Wave" />
            <MudSkeleton Height="220px" Animation="Animation.Wave" />
        </MudStack>
    }
    else if (_error is not null)
    {
        <div class="review-shell page-enter">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="glass-card">@_error</MudAlert>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBackToSafePage" Class="mt-3">
                Go back
            </MudButton>
        </div>
    }
    else if (_isModeratorMode)
    {
        <div class="review-shell page-enter">
            <header class="review-header">
                <div>
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Moderator review</MudText>
                    <MudText Typo="Typo.h3" Class="review-title">@_summary?.FolderName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Review each ready file independently. AI advice never replaces your decision.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoToQueue">
                    Back to queue
                </MudButton>
            </header>

            @if (_documents.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="glass-card mb-4">
                    No documents are currently waiting for a moderation decision in this folder.
                </MudAlert>
            }
            else
            {
                <MudPaper Elevation="0" Class="glass-card document-list mb-4">
                    @foreach (var document in _documents)
                    {
                        var decision = GetDocumentDecision(document.Id);
                        var isActionable = IsActionable(document, decision);
                        _aiAdvisories.TryGetValue(document.Id, out var aiAdvisory);
                        <article class="document-row">
                            <div class="document-copy">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="document-name">@document.FileName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @document.SubjectCode · @document.Semester · @FormatFileSize(document.FileSizeBytes)
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(decision?.Reason))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error" Class="decision-reason">@decision.Reason</MudText>
                                    }
                                    @if (aiAdvisory is not null)
                                    {
                                        <div class="ai-advisory" role="status" title="@aiAdvisory.Message">
                                            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
                                            <span>AI suggestion: @GetAiAdvisoryLabel(aiAdvisory) · @FormatAiConfidence(aiAdvisory.Confidence)</span>
                                            <strong>Advisory only</strong>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="document-actions">
                                @if (!isActionable)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@GetDocumentStatusColor(document, decision)">
                                        @GetDocumentStatusLabel(document, decision)
                                    </MudChip>
                                }
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Disabled="@IsBusy(document.Id)" OnClick="() => OpenDocumentAsync(document)">
                                    Open
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                                           Disabled="@(IsBusy(document.Id) || !isActionable)" OnClick="() => ApproveDocumentAsync(document)">
                                    Approve
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                                           Disabled="@(IsBusy(document.Id) || !isActionable)" OnClick="() => AiReviewDocumentAsync(document)">
                                    AI Review
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           Disabled="@(IsBusy(document.Id) || !isActionable)" OnClick="() => RejectDocumentAsync(document)">
                                    Reject
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Flag"
                                           Disabled="@(IsBusy(document.Id) || !isActionable)" OnClick="() => EscalateDocumentAsync(document)">
                                    Escalate
                                </MudButton>
                            </div>
                        </article>
                    }
                </MudPaper>
            }

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="glass-card review-guidance">
                Folder publication is derived from file decisions. Escalated files are locked until an administrator resolves them.
            </MudAlert>
        </div>
    }
    else if (_folder is not null)
    {
        <div class="review-shell owner-shell page-enter">
            <MudStack AlignItems="AlignItems.Center" Class="owner-heading">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Share status</MudText>
                <MudText Typo="Typo.h3" Class="review-title">@_folder.Name</MudText>
            </MudStack>

            @switch (_folder.ShareStatus)
            {
                case FolderStatus.PendingShare:
                    <MudPaper Elevation="0" Class="glass-card owner-state">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" Class="state-icon" />
                        <MudText Typo="Typo.h5" Class="review-subtitle">Waiting for moderator review</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            Your folder has been submitted. A moderator will review it before it can appear in Community.
                        </MudText>
                        <MudButton Variant="Variant.Outlined" OnClick="GoToFolder">Back to my documents</MudButton>
                    </MudPaper>
                    break;
                case FolderStatus.Rejected:
                    <MudPaper Elevation="0" Class="glass-card owner-state">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Class="state-icon" />
                        <MudText Typo="Typo.h5" Class="review-subtitle">Sharing request rejected</MudText>
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="reason-box">
                            <strong>Moderator reason:</strong><br />@GetOwnerRejectionReason()
                        </MudAlert>
                        <div class="owner-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                                       Disabled="@_ownerActionBusy" OnClick="ResubmitAsync">Resubmit for review</MudButton>
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Lock"
                                       Disabled="@_ownerActionBusy" OnClick="KeepPrivate">Keep folder private</MudButton>
                        </div>
                    </MudPaper>
                    break;
                case FolderStatus.Approved:
                    <MudPaper Elevation="0" Class="glass-card owner-state">
                        <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Success" Class="state-icon" />
                        <MudText Typo="Typo.h5" Class="review-subtitle">Published to Community</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            This folder is public and available in Community.
                        </MudText>
                        <div class="owner-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToCommunity">Open Community</MudButton>
                            <MudButton Variant="Variant.Outlined" OnClick="GoToFolder">Back to my documents</MudButton>
                        </div>
                    </MudPaper>
                    break;
                default:
                    <MudPaper Elevation="0" Class="glass-card owner-state">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Secondary" Class="state-icon" />
                        <MudText Typo="Typo.h5" Class="review-subtitle">Private folder</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">This folder is not currently submitted for Community sharing.</MudText>
                        <MudButton Variant="Variant.Outlined" OnClick="GoToFolder">Back to my documents</MudButton>
                    </MudPaper>
                    break;
            }

            <section class="owner-files" aria-labelledby="owner-files-heading">
                <div class="owner-files-heading">
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">File visibility</MudText>
                        <MudText Typo="Typo.h5" Class="review-subtitle" id="owner-files-heading">Review results by file</MudText>
                    </div>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_documents.Count file(s)</MudChip>
                </div>

                @if (_documents.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="glass-card">
                        This folder has no files to display.
                    </MudAlert>
                }
                else
                {
                    <div class="owner-file-list">
                        @foreach (var document in _documents)
                        {
                            var reviewLabel = GetOwnerDocumentStatusLabel(document);
                            var reviewFeedback = GetOwnerDocumentFeedback(document);
                            <article class="glass-card owner-file-card">
                                <div class="owner-file-main">
                                    <div class="owner-file-icon"><MudIcon Icon="@Icons.Material.Filled.Description" /></div>
                                    <div class="owner-file-copy">
                                        <MudText Typo="Typo.subtitle2" Class="document-name">@document.FileName</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @document.SubjectCode · @document.Semester · @FormatFileSize(document.FileSizeBytes)
                                        </MudText>
                                        <div class="owner-file-badges">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetOwnerDocumentStatusColor(document)">@reviewLabel</MudChip>
                                            <span class="visibility-badge @(document.ReviewStatus == DocumentReviewStatus.Approved ? "public" : "private")">
                                                <MudIcon Icon="@(document.ReviewStatus == DocumentReviewStatus.Approved ? Icons.Material.Filled.Public : Icons.Material.Filled.Lock)" />
                                                @(document.ReviewStatus == DocumentReviewStatus.Approved ? "Public in Community" : "Private")
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(reviewFeedback))
                                        {
                                            <div class="owner-file-feedback">
                                                <strong>@GetOwnerFeedbackLabel(document):</strong>
                                                <span>@reviewFeedback</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                @if (document.ReviewStatus == DocumentReviewStatus.Rejected)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                                               Disabled="@IsBusy(document.Id)"
                                               OnClick="@(() => ConfirmDeleteRejectedDocumentAsync(document))"
                                               aria-label="@($"Delete rejected file {document.FileName}")">
                                        Delete rejected file
                                    </MudButton>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public Guid FolderId { get; set; }
    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private FolderDto? _folder;
    private ShareReviewSummaryDto? _summary;
    private readonly List<DocumentDto> _documents = new();
    private readonly Dictionary<Guid, DocumentDecision> _documentDecisions = new();
    private readonly Dictionary<Guid, AiAdvisoryDisplay> _aiAdvisories = new();
    private bool _isLoading = true;
    private bool _ownerActionBusy;
    private Guid? _busyDocumentId;
    private string? _error;

    private bool _isModeratorMode => string.Equals(Mode, "moderator", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var token = RequireToken();
            if (_isModeratorMode)
            {
                var summaryTask = FoldersApi.GetReviewerShareReviewAsync(token, FolderId);
                var documentsTask = DashboardApi.GetPendingModerationDocumentsAsync(token, FolderId);
                await Task.WhenAll(summaryTask, documentsTask);
                _summary = await summaryTask;
                _documents.Clear();
                _documents.AddRange(await documentsTask);
                _documentDecisions.Clear();
                _aiAdvisories.Clear();
            }
            else
            {
                var folderTask = FoldersApi.GetAsync(token, FolderId);
                var documentsTask = DocumentsApi.ListAsync(token, new DocumentListQuery { FolderId = FolderId });
                await Task.WhenAll(folderTask, documentsTask);
                _folder = await folderTask;
                _documents.Clear();
                _documents.AddRange(await documentsTask);
            }
        }
        catch (DocumentApiException ex)
        {
            _error = MapApiError(ex, "Unable to load this share review.");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch
        {
            _error = "Unable to load this share review. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string RequireToken()
    {
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken))
            throw new InvalidOperationException("Please log in to open this page.");
        return Session.AccessToken;
    }

    private async Task OpenDocumentAsync(DocumentDto document)
    {
        await RunDocumentActionAsync(document.Id, async token =>
        {
            var url = await DashboardApi.GetModerationDocumentSignedUrlAsync(token, document.Id);
            if (string.IsNullOrWhiteSpace(url))
                throw new InvalidOperationException("A document link could not be created.");
            Navigation.NavigateTo(url, forceLoad: true);
        }, "Unable to open this document.");
    }

    private async Task ApproveDocumentAsync(DocumentDto document)
    {
        await RunDocumentActionAsync(document.Id, async token =>
        {
            await DashboardApi.ApproveDocumentAsync(token, document.Id);
            _documentDecisions[document.Id] = new DocumentDecision(true, null);
            Snackbar.Add($"Document '{document.FileName}' approved.", Severity.Success);
        }, "Unable to approve this document.");
    }

    private async Task AiReviewDocumentAsync(DocumentDto document)
    {
        await RunDocumentActionAsync(document.Id, async token =>
        {
            var result = await DashboardApi.AiReviewDocumentAsync(token, document.Id);
            _aiAdvisories[document.Id] = new AiAdvisoryDisplay(result.AdvisoryOutcome, result.Confidence, result.Message);
            Snackbar.Add($"AI advisory ready for '{document.FileName}'. Human review is still required.", Severity.Info);
        }, "Unable to run AI review for this document.");
    }

    private async Task RejectDocumentAsync(DocumentDto document)
    {
        var dialog = await DialogService.ShowAsync<ModeratorRejectReasonDialog>(
            "Reject Document",
            new DialogParameters { ["DialogTitle"] = "Reject Document", ["ItemName"] = document.FileName },
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string reason) return;

        await RunDocumentActionAsync(document.Id, async token =>
        {
            await DashboardApi.RejectDocumentAsync(token, document.Id, reason);
            _documentDecisions[document.Id] = new DocumentDecision(false, reason);
            Snackbar.Add($"Document '{document.FileName}' rejected.", Severity.Warning);
        }, "Unable to reject this document.");
    }

    private async Task EscalateDocumentAsync(DocumentDto selectedDocument)
    {
        var eligibleDocuments = _documents
            .Where(IsEligibleForEscalation)
            .Select(document => new EscalationDialog.RejectedDocItem
            {
                DocumentId = document.Id,
                FileName = document.FileName,
                RejectReason = GetEscalationDocumentReason(document)
            })
            .ToList();

        if (eligibleDocuments.Count == 0)
        {
            Snackbar.Add("No ready, undecided files are available for escalation.", Severity.Info);
            return;
        }

        foreach (var item in eligibleDocuments)
            item.Selected = item.DocumentId == selectedDocument.Id;

        var dialog = await DialogService.ShowAsync<EscalationDialog>(
            "Escalate to Admin",
            new DialogParameters
            {
                ["FolderName"] = _summary?.FolderName ?? "Folder",
                ["FolderId"] = FolderId,
                ["RejectedDocuments"] = eligibleDocuments
            },
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false } || result.Data is not EscalationDialog.EscalationDialogResult data) return;

        await RunDocumentActionAsync(selectedDocument.Id, async token =>
        {
            await EscalationApi.CreateAsync(token, new CreateEscalationRequest
            {
                FolderId = FolderId,
                Reason = data.Reason,
                Items = data.Items
            });
            foreach (var item in data.Items)
                _documentDecisions[item.DocumentId] = DocumentDecision.EscalatedDecision;
            Snackbar.Add($"{data.Items.Count} file(s) escalated to an administrator.", Severity.Success);
            await LoadAsync();
        }, "Unable to escalate the selected files.");
    }

    private async Task ResubmitAsync()
    {
        _ownerActionBusy = true;
        try
        {
            var token = RequireToken();
            _folder = await FoldersApi.RequestShareAsync(token, FolderId);
            Snackbar.Add("Folder resubmitted for moderator review.", Severity.Success);
        }
        catch (DocumentApiException ex)
        {
            Snackbar.Add(MapApiError(ex, "Unable to resubmit this folder."), Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex is InvalidOperationException ? ex.Message : "Unable to resubmit this folder.", Severity.Error);
        }
        finally
        {
            _ownerActionBusy = false;
        }
    }

    private void KeepPrivate()
    {
        Snackbar.Add("Folder remains private.", Severity.Info);
        GoToFolder();
    }

    private async Task ConfirmDeleteRejectedDocumentAsync(DocumentDto document)
    {
        if (document.ReviewStatus != DocumentReviewStatus.Rejected) return;

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(
            "Delete rejected file",
            new DialogParameters
            {
                ["Title"] = "Delete rejected file?",
                ["Message"] = $"Delete rejected file \"{document.FileName}\"? This removes only this file. The folder and every approved sibling remain unchanged.",
                ["ConfirmText"] = "Delete rejected file",
                ["ConfirmColor"] = Color.Error,
                ["Icon"] = Icons.Material.Filled.DeleteForever,
                ["IconColor"] = Color.Error
            },
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        await DeleteRejectedDocumentAsync(document);
    }

    private async Task DeleteRejectedDocumentAsync(DocumentDto document)
    {
        _busyDocumentId = document.Id;
        try
        {
            await DocumentsApi.DeleteAsync(RequireToken(), document.Id);
            Snackbar.Add($"Deleted rejected file '{document.FileName}'. Approved files and the folder were not changed.", Severity.Success);
            await LoadAsync();
        }
        catch (DocumentApiException ex)
        {
            Snackbar.Add(MapOwnerDeleteError(ex), Severity.Error);
            if (ex.StatusCode == 401)
            {
                Session.Clear();
                Navigation.NavigateTo("/login", replace: true);
            }
            else if (ex.StatusCode is 404 or 409)
            {
                await LoadAsync();
            }
        }
        catch
        {
            Snackbar.Add("Unable to delete this rejected file. Please try again.", Severity.Error);
        }
        finally
        {
            _busyDocumentId = null;
        }
    }

    private async Task RunDocumentActionAsync(Guid documentId, Func<string, Task> action, string fallbackMessage)
    {
        _busyDocumentId = documentId;
        try
        {
            await action(RequireToken());
        }
        catch (DocumentApiException ex)
        {
            Snackbar.Add(MapApiError(ex, fallbackMessage), Severity.Error);
            if (ex.StatusCode == 409)
                await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex is InvalidOperationException ? ex.Message : fallbackMessage, Severity.Error);
        }
        finally
        {
            _busyDocumentId = null;
        }
    }

    private static string MapApiError(DocumentApiException ex, string fallback) => ex.StatusCode switch
    {
        401 => "Your session has expired. Please log in again.",
        403 => "You do not have permission to perform this action.",
        404 => "This folder or document could not be found.",
        409 => "This file changed while you were reviewing it. The latest moderation state has been reloaded.",
        _ => string.IsNullOrWhiteSpace(ex.Message) ? fallback : ex.Message
    };

    private static string MapOwnerDeleteError(DocumentApiException ex) => ex.StatusCode switch
    {
        401 => "Your session expired. Sign in again to continue.",
        403 => "Only the folder owner can delete this rejected file.",
        404 => "This file was already removed. The latest folder state has been loaded.",
        409 => "This file changed and can no longer be deleted from this review. The latest state has been loaded.",
        _ => string.IsNullOrWhiteSpace(ex.Message) ? "Unable to delete this rejected file." : ex.Message
    };

    private string GetOwnerRejectionReason() =>
        FirstNonEmpty(_folder?.StudentFeedbackReason, _folder?.HumanReviewReason)
        ?? "The moderator did not provide a reason.";

    private static string? FirstNonEmpty(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private DocumentDecision? GetDocumentDecision(Guid documentId) =>
        _documentDecisions.GetValueOrDefault(documentId);

    private bool IsEligibleForEscalation(DocumentDto document)
    {
        var localDecision = GetDocumentDecision(document.Id);
        return IsActionable(document, localDecision);
    }

    private string GetEscalationDocumentReason(DocumentDto document)
    {
        var localDecision = GetDocumentDecision(document.Id);
        if (!string.IsNullOrWhiteSpace(localDecision?.Reason))
            return localDecision.Reason;

        if (document.ReviewStatus == DocumentReviewStatus.Rejected)
            return string.IsNullOrWhiteSpace(document.ErrorMessage)
                ? "Rejected during moderator review."
                : document.ErrorMessage;

        return "Requires administrator review.";
    }

    private bool IsBusy(Guid documentId) => _busyDocumentId == documentId;

    private static bool IsActionable(DocumentDto document, DocumentDecision? localDecision) =>
        document.Status == DocumentStatus.Ready
        && document.ReviewStatus == DocumentReviewStatus.None
        && localDecision is null;

    private static string GetDocumentStatusLabel(DocumentDto document, DocumentDecision? localDecision)
    {
        if (localDecision?.Escalated == true || document.ReviewStatus == DocumentReviewStatus.Escalated) return "Escalated — admin review";
        if (localDecision?.Approved == true || document.ReviewStatus == DocumentReviewStatus.Approved) return "Approved";
        if (localDecision is not null || document.ReviewStatus == DocumentReviewStatus.Rejected) return "Rejected";
        return document.Status == DocumentStatus.Ready ? "Awaiting decision" : "Waiting for ingestion";
    }

    private static Color GetDocumentStatusColor(DocumentDto document, DocumentDecision? localDecision)
    {
        if (localDecision?.Escalated == true || document.ReviewStatus == DocumentReviewStatus.Escalated) return Color.Info;
        if (localDecision?.Approved == true || document.ReviewStatus == DocumentReviewStatus.Approved) return Color.Success;
        if (localDecision is not null || document.ReviewStatus == DocumentReviewStatus.Rejected) return Color.Error;
        return Color.Warning;
    }

    private static string GetOwnerDocumentStatusLabel(DocumentDto document) => document.ReviewStatus switch
    {
        DocumentReviewStatus.Approved => "Approved",
        DocumentReviewStatus.Rejected => "Rejected",
        DocumentReviewStatus.Escalated => "Escalated — awaiting admin",
        _ => document.Status == DocumentStatus.Ready ? "Pending review" : "Preparing for review"
    };

    private static Color GetOwnerDocumentStatusColor(DocumentDto document) => document.ReviewStatus switch
    {
        DocumentReviewStatus.Approved => Color.Success,
        DocumentReviewStatus.Rejected => Color.Error,
        DocumentReviewStatus.Escalated => Color.Info,
        _ => Color.Warning
    };

    private static string GetOwnerFeedbackLabel(DocumentDto document) =>
        document.ShareReviewSource?.Contains("admin", StringComparison.OrdinalIgnoreCase) == true
        || !string.IsNullOrWhiteSpace(document.GetType().GetProperty("AdminResponse")?.GetValue(document)?.ToString())
        || !string.IsNullOrWhiteSpace(document.GetType().GetProperty("AdminReviewReason")?.GetValue(document)?.ToString())
            ? "Administrator feedback"
            : "Moderator feedback";

    private static string? GetOwnerDocumentFeedback(DocumentDto document)
    {
        if (!string.IsNullOrWhiteSpace(document.ModerationReason)) return document.ModerationReason;
        foreach (var propertyName in new[] { "AdminResponse", "AdminReviewReason", "RejectionReason", "ReviewReason", "HumanReviewReason" })
        {
            var value = document.GetType().GetProperty(propertyName)?.GetValue(document)?.ToString();
            if (!string.IsNullOrWhiteSpace(value)) return value;
        }
        return document.ReviewStatus == DocumentReviewStatus.Rejected ? document.ErrorMessage : null;
    }

    private static string GetAiAdvisoryLabel(AiAdvisoryDisplay advisory) => advisory.Outcome switch
    {
        DocumentAiAdvisoryOutcome.Approve => "Approve",
        DocumentAiAdvisoryOutcome.Reject => "Reject",
        _ => "Needs human review"
    };

    private static string FormatAiConfidence(double confidence) =>
        $"{Math.Round(Math.Clamp(confidence, 0, 1) * 100):0}%";

    private static string FormatFileSize(long bytes) => bytes switch
    {
        >= 1_048_576 => $"{bytes / 1_048_576d:F1} MB",
        >= 1_024 => $"{bytes / 1_024d:F1} KB",
        _ => $"{bytes} B"
    };

    private void GoBackToSafePage() => Navigation.NavigateTo(_isModeratorMode ? "/dashboard/share-reviews" : "/documents");
    private void GoToQueue() => Navigation.NavigateTo("/dashboard/share-reviews");
    private void GoToFolder() => Navigation.NavigateTo("/documents");
    private void GoToCommunity() => Navigation.NavigateTo("/community");

    private sealed record DocumentDecision(bool Approved, string? Reason, bool Escalated = false)
    {
        public static DocumentDecision EscalatedDecision { get; } = new(false, null, true);
    }

    private sealed record AiAdvisoryDisplay(DocumentAiAdvisoryOutcome Outcome, double Confidence, string Message);
}
