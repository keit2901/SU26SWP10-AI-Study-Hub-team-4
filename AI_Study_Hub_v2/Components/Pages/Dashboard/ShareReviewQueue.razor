@page "/dashboard/share-reviews"
@layout DashboardLayout
@using AI_Study_Hub_v2.Components.Layout
@using AI_Study_Hub_v2.Data.Entities
@using AI_Study_Hub_v2.Dtos
@inject AuthSessionState Session
@inject FolderApiClient FolderApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Share Review Queue - AI Study Hub</PageTitle>

<main style="flex: 1; overflow-y: auto;">
    <div style="padding: 2rem; max-width: 82rem; margin: 0 auto;">
        <header style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
            <div>
                <h1 style="font-size: 1.7rem; font-weight: 800; color: #111827; letter-spacing: -0.03em; margin: 0;">Share Review Queue</h1>
                <p style="margin: 0.35rem 0 0; color: #64748b; font-size: 0.95rem;">
                    Review folders submitted by students, inspect their documents, then decide manually.
                </p>
            </div>
            <div style="display: inline-flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <div style="display: inline-flex; align-items: center; gap: 0.55rem; border-radius: 999px; padding: 0.55rem 0.95rem; background: #eef2ff; color: #4338ca; font-weight: 700; font-size: 0.82rem;">
                    <MudIcon Icon="@Icons.Material.Filled.Gavel" Style="font-size: 1rem;" />
                    @_pendingFolders.Count pending
                </div>
                <button @onclick="LoadAsync"
                        disabled="@_isRefreshing"
                        style="@GetActionStyle(_isRefreshing, "#eef2ff", "#4338ca", "#c7d2fe")">
                    <MudIcon Icon="@Icons.Material.Filled.Refresh" Style="font-size: 1rem;" />
                    Refresh
                </button>
            </div>
        </header>

        @if (_loading)
        {
            <div style="display: flex; justify-content: center; padding: 3rem 0;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!_isAuthorized)
        {
            <div style="border: 1px solid #fecaca; background: #fff7f7; color: #991b1b; border-radius: 1rem; padding: 1rem 1.1rem;">
                Moderator or admin access is required to open this page.
            </div>
        }
        else if (_pendingFolders.Count == 0)
        {
            <div style="border: 1px solid #e2e8f0; background: #fff; border-radius: 1rem; padding: 2.25rem 1.5rem; text-align: center; box-shadow: 0 16px 40px rgba(15,23,42,0.05);">
                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Style="font-size: 2.5rem; color: #22c55e;" />
                <h2 style="margin: 0.9rem 0 0.35rem; font-size: 1.1rem; font-weight: 800; color: #111827;">No folders waiting for review</h2>
                <p style="margin: 0; color: #64748b;">New student share requests will appear here automatically.</p>
            </div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.1rem 1.2rem;">
                    <div style="font-size: 0.72rem; font-weight: 800; color: #64748b; letter-spacing: 0.08em; text-transform: uppercase;">Pending Queue</div>
                    <div style="margin-top: 0.35rem; font-size: 1.85rem; font-weight: 800; color: #111827;">@_pendingFolders.Count</div>
                    <div style="margin-top: 0.3rem; color: #64748b; font-size: 0.84rem;">Folders submitted by students and waiting for review.</div>
                </div>
                <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.1rem 1.2rem;">
                    <div style="font-size: 0.72rem; font-weight: 800; color: #64748b; letter-spacing: 0.08em; text-transform: uppercase;">Document Review</div>
                    <div style="margin-top: 0.35rem; font-size: 1.85rem; font-weight: 800; color: #111827;">Open Queue</div>
                    <div style="margin-top: 0.3rem; color: #64748b; font-size: 0.84rem;">Open a folder to inspect every submitted document before deciding.</div>
                </div>
                <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 1.1rem 1.2rem;">
                    <div style="font-size: 0.72rem; font-weight: 800; color: #64748b; letter-spacing: 0.08em; text-transform: uppercase;">Manual Control</div>
                    <div style="margin-top: 0.35rem; font-size: 1.85rem; font-weight: 800; color: #111827;">Approve / Reject</div>
                    <div style="margin-top: 0.3rem; color: #64748b; font-size: 0.84rem;">Moderators can still review documents and decide manually.</div>
                </div>
            </div>

            <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 1.1rem; box-shadow: 0 16px 40px rgba(15,23,42,0.05); overflow: hidden;">
                <div style="padding: 1rem 1.15rem; border-bottom: 1px solid #e2e8f0; background: #f8fafc;">
                    <div style="font-size: 0.8rem; font-weight: 800; color: #475569; letter-spacing: 0.08em; text-transform: uppercase;">Moderator Queue</div>
                </div>
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                        <thead>
                            <tr style="background: #f8fafc;">
                                <th style="@HeaderCellStyle">Folder</th>
                                <th style="@HeaderCellStyle">Owner</th>
                                <th style="@HeaderCellStyle">Subject</th>
                                <th style="@HeaderCellStyle">Submitted</th>
                                <th style="@HeaderCellStyle">Moderator Note</th>
                                <th style="@HeaderCellStyle">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in _pendingFolders)
                            {
                                var isBusy = _busyFolderId == item.Id;
                                <tr style="border-top: 1px solid #e2e8f0;">
                                    <td style="@BodyCellStyle">
                                        <div style="font-weight: 700; color: #0f172a;">@GetFolderDisplayName(item)</div>
                                        <div style="margin-top: 0.25rem; color: #64748b; font-size: 0.8rem;">@item.DocumentCount source@(item.DocumentCount == 1 ? string.Empty : "s")</div>
                                    </td>
                                    <td style="@BodyCellStyle">
                                        <div style="font-weight: 700; color: #1e293b;">@item.OwnerName</div>
                                        <div style="margin-top: 0.25rem; color: #64748b; font-size: 0.8rem;">@item.Semester</div>
                                    </td>
                                    <td style="@BodyCellStyle">
                                        <span style="display: inline-flex; align-items: center; border-radius: 999px; padding: 0.35rem 0.7rem; background: #eef2ff; color: #4338ca; font-size: 0.8rem; font-weight: 700;">@item.SubjectCode</span>
                                    </td>
                                    <td style="@BodyCellStyle">
                                        <div style="font-weight: 700; color: #1e293b;">@item.SubmittedAt.LocalDateTime.ToString("dd/MM/yyyy")</div>
                                        <div style="margin-top: 0.25rem; color: #64748b; font-size: 0.8rem;">@item.SubmittedAt.LocalDateTime.ToString("HH:mm")</div>
                                    </td>
                                    <td style="@BodyCellStyle">
                                        <div style="color: #475569; line-height: 1.45; font-size: 0.84rem;">
                                            @(!string.IsNullOrWhiteSpace(item.AppealMessage)
                                                ? item.AppealMessage
                                                : "Waiting for moderator review. Student feedback will appear here when it is submitted.")
                                        </div>
                                    </td>
                                    <td style="@BodyCellStyle">
                                        <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
                                            <button @onclick="() => OpenFeedbackAsync(item)"
                                                    disabled="@(isBusy || !HasStudentFeedback(item))"
                                                    style="@GetFeedbackActionStyle(isBusy, HasStudentFeedback(item))">
                                                View Feedback
                                            </button>
                                            <button @onclick="() => OpenReview(item.Id)"
                                                    disabled="@isBusy"
                                                    style="@GetActionStyle(isBusy, "#eef2ff", "#4338ca", "#c7d2fe")">
                                                Open Review
                                            </button>
                                            <button @onclick="() => ApproveAsync(item.Id)"
                                                    disabled="@isBusy"
                                                    style="@GetActionStyle(isBusy, "#ecfdf5", "#047857", "#a7f3d0")">
                                                Approve
                                            </button>
                                            <button @onclick="() => RejectAsync(item)"
                                                    disabled="@isBusy"
                                                    style="@GetActionStyle(isBusy, "#fef2f2", "#b91c1c", "#fecaca")">
                                                Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</main>

@code {
    private readonly List<PendingShareFolderDto> _pendingFolders = new();
    private bool _loading = true;
    private bool _isAuthorized = true;
    private bool _isRefreshing;
    private Guid? _busyFolderId;

    private static string HeaderCellStyle =>
        "padding: 0.85rem 1rem; text-align: left; color: #64748b; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; white-space: nowrap;";

    private static string BodyCellStyle =>
        "padding: 1rem; vertical-align: top; border-bottom: 1px solid #e2e8f0; font-size: 0.9rem;";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _isRefreshing = true;
        try
        {
            if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                _isAuthorized = false;
                _pendingFolders.Clear();
                return;
            }

            _pendingFolders.Clear();
            _pendingFolders.AddRange(await FolderApi.GetPendingShareReviewQueueAsync(Session.AccessToken));
            _isAuthorized = true;
        }
        catch (DocumentApiException ex) when (ex.StatusCode is StatusCodes.Status401Unauthorized or StatusCodes.Status403Forbidden)
        {
            _isAuthorized = false;
            _pendingFolders.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add("Unable to load share review queue: " + ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            _isRefreshing = false;
        }
    }

    private void OpenReview(Guid folderId) =>
        Nav.NavigateTo($"/share-review/{folderId}?mode=moderator");

    private async Task ApproveAsync(Guid folderId)
    {
        await RunActionAsync(folderId, async () =>
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                Snackbar.Add("Authentication required.", Severity.Error);
                return;
            }

            await FolderApi.ApproveShareAsync(Session.AccessToken, folderId);
            Snackbar.Add("Folder approved for community sharing.", Severity.Success);
        });
    }

    private async Task RejectAsync(PendingShareFolderDto item)
    {
        var dialog = await DialogService.ShowAsync<AI_Study_Hub_v2.Components.Shared.ModeratorRejectReasonDialog>(
            "Reject Folder Share",
            new DialogParameters
            {
                ["ItemName"] = item.Name
            },
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string reason)
        {
            return;
        }

        await RunActionAsync(item.Id, async () =>
        {
            if (string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                Snackbar.Add("Authentication required.", Severity.Error);
                return;
            }

            await FolderApi.RejectShareAsync(
                Session.AccessToken,
                item.Id,
                new RejectFolderShareRequest { Reason = reason });
            Snackbar.Add("Folder rejected from community sharing.", Severity.Warning);
        });
    }

    private async Task RunActionAsync(Guid folderId, Func<Task> action)
    {
        if (_busyFolderId.HasValue)
        {
            return;
        }

        _busyFolderId = folderId;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (DocumentApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busyFolderId = null;
        }
    }

    private static string GetActionStyle(bool isBusy, string background, string color, string borderColor) =>
        $"display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid {(isBusy ? "#d1d5db" : borderColor)}; background: {(isBusy ? "#f3f4f6" : background)}; color: {(isBusy ? "#9ca3af" : color)}; padding: 0.45rem 0.8rem; font-size: 0.78rem; font-weight: 700; cursor: {(isBusy ? "not-allowed" : "pointer")};";

    private static string GetFeedbackActionStyle(bool isBusy, bool hasStudentFeedback)
    {
        if (isBusy)
        {
            return GetActionStyle(true, "#f3f4f6", "#9ca3af", "#d1d5db");
        }

        return hasStudentFeedback
            ? GetActionStyle(false, "#fff7ed", "#c2410c", "#fdba74")
            : GetActionStyle(false, "#ffffff", "#94a3b8", "#e2e8f0");
    }

    private static bool HasStudentFeedback(PendingShareFolderDto item) =>
        !string.IsNullOrWhiteSpace(item.StudentFeedbackReason)
        || !string.IsNullOrWhiteSpace(item.AppealMessage);

    private static string GetFolderDisplayName(PendingShareFolderDto item) =>
        $"{item.Name} (Fail {item.ShareFailureCount} times)";

    private async Task OpenFeedbackAsync(PendingShareFolderDto item)
    {
        if (!HasStudentFeedback(item))
        {
            Snackbar.Add("Student has not sent feedback yet.", Severity.Info);
            return;
        }

        var folder = new FolderDto
        {
            Id = item.Id,
            Name = item.Name,
            ShareStatus = FolderStatus.PendingShare,
            ShareFailureCount = item.ShareFailureCount,
            StudentFeedbackReason = item.StudentFeedbackReason,
            AppealMessage = item.AppealMessage,
            UpdatedAt = item.SubmittedAt
        };

        await DialogService.ShowAsync<AI_Study_Hub_v2.Components.Shared.FolderReviewFeedbackDialog>(
            "Review Feedback",
            new DialogParameters { ["Folder"] = folder },
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
    }

}
