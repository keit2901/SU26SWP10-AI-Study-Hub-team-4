    private static bool CanRequestHumanReview(FolderDto folder) =>
        folder.ShareStatus == Data.Entities.FolderStatus.Rejected
        && folder.ShareFailureCount >= 2;

    private static bool CanShowFeedbackAction(FolderDto folder) =>
        folder.ShareStatus == Data.Entities.FolderStatus.Rejected;

    private static bool CanAttemptFeedback(FolderDto folder) =>
        folder.ShareStatus == Data.Entities.FolderStatus.Rejected
        && folder.ShareFailureCount >= 2;

    private static bool CanResubmitShare(FolderDto folder) =>
        folder.ShareStatus == Data.Entities.FolderStatus.Rejected;

    private static bool HasReviewFeedback(FolderDto folder) =>
        folder.ShareStatus == Data.Entities.FolderStatus.Approved
        || folder.ShareStatus == Data.Entities.FolderStatus.Rejected
        || !string.IsNullOrWhiteSpace(folder.HumanReviewReason)
        || !string.IsNullOrWhiteSpace(folder.AiReviewReason)
        || !string.IsNullOrWhiteSpace(folder.StudentFeedbackReason)
        || !string.IsNullOrWhiteSpace(folder.AppealMessage);

    private static bool IsHumanReviewPending(FolderDto folder) =>
        folder.ShareStatus == Data.Entities.FolderStatus.PendingShare
        && folder.AppealRequestedAt.HasValue;

    private static bool MatchesPersonalStatusFilter(FolderDto folder, string statusFilter)
    {
        return statusFilter switch
        {
            "Pending Review" => folder.ShareStatus == Data.Entities.FolderStatus.PendingShare,
            _ => GetPersonalShareStatusText(folder) == statusFilter
        };
    }

    private static DateTimeOffset GetPersonalActivityTimestamp(FolderDto folder) =>
        folder.AppealRequestedAt
        ?? folder.SharedAt
        ?? folder.UpdatedAt;

    private static string GetShareFailureReason(FolderDto folder) =>
        !string.IsNullOrWhiteSpace(folder.HumanReviewReason)
            ? folder.HumanReviewReason
            : !string.IsNullOrWhiteSpace(folder.AiReviewReason)
                ? folder.AiReviewReason
                : "This folder was not approved for community sharing.";

    private static string GetPendingModeratorMessage(FolderDto folder) =>
        string.IsNullOrWhiteSpace(folder.AppealMessage)
            ? "Your request has been sent to the moderator queue."
            : $"Moderator note received: {folder.AppealMessage}";

    private static string GetPendingSubmittedText(FolderDto folder)
        => GetPersonalActivityTimestamp(folder).LocalDateTime.ToString("dd/MM/yyyy HH:mm");

    private static string GetLatestActivityText(FolderDto folder)
    {
        var timestamp = GetPersonalActivityTimestamp(folder).LocalDateTime.ToString("dd/MM/yyyy HH:mm");

        return folder.ShareStatus switch
        {
            Data.Entities.FolderStatus.Approved => $"Shared on {timestamp}",
            Data.Entities.FolderStatus.PendingShare when string.Equals(folder.ShareReviewSource, "STUDENT_FEEDBACK", StringComparison.OrdinalIgnoreCase)
                => $"Feedback sent on {timestamp}",
            Data.Entities.FolderStatus.PendingShare => $"Waiting for moderator review since {timestamp}",
            Data.Entities.FolderStatus.Rejected when string.Equals(folder.ShareReviewSource, "AI_ASSIST", StringComparison.OrdinalIgnoreCase)
                => $"AI review failed on {timestamp}",
            Data.Entities.FolderStatus.Rejected => $"Moderator rejected on {timestamp}",
            _ => $"Updated on {timestamp}"
        };
    }

    private static string GetLatestReasonPreview(FolderDto folder)
    {
        var reason = !string.IsNullOrWhiteSpace(folder.HumanReviewReason)
            ? folder.HumanReviewReason
            : !string.IsNullOrWhiteSpace(folder.AiReviewReason)
                ? folder.AiReviewReason
                : !string.IsNullOrWhiteSpace(folder.StudentFeedbackReason)
                    ? folder.StudentFeedbackReason
                    : !string.IsNullOrWhiteSpace(folder.AppealMessage)
                        ? folder.AppealMessage
                        : null;

        if (folder.ShareStatus == Data.Entities.FolderStatus.Approved)
        {
            return "Folder is now visible in community sharing.";
        }

        if (string.IsNullOrWhiteSpace(reason))
        {
            return folder.ShareStatus == Data.Entities.FolderStatus.PendingShare
                ? "Waiting for moderator review."
                : "No detailed reason yet.";
        }

        return reason.Length <= 120
            ? reason
            : reason[..117] + "...";
    }

    private static string GetPersonalShareSupportMessage(FolderDto folder)
    {
        var reason = GetShareFailureReason(folder);

        return folder.ShareStatus switch
        {
            Data.Entities.FolderStatus.Rejected
                => $"This folder was not approved. Reason: {reason}",
            Data.Entities.FolderStatus.PendingShare
                => string.IsNullOrWhiteSpace(folder.AppealMessage)
                    ? "Your folder is waiting for moderator review."
                    : $"Moderator will review this folder. Your note: {folder.AppealMessage}",
            _ => reason
        };
    }

    private static string GetShareDecisionMessage(FolderDto folder)
    {
        var reason = string.IsNullOrWhiteSpace(GetShareFailureReason(folder))
            ? string.Empty
            : $" Reason: {GetShareFailureReason(folder)}";

        return folder.ShareStatus switch
        {
            Data.Entities.FolderStatus.Approved => "Folder approved for community sharing.",
            Data.Entities.FolderStatus.Rejected => $"Folder was not approved for community sharing.{reason}",
            Data.Entities.FolderStatus.PendingShare => "Share request submitted. Your folder is waiting for moderator review.",
            _ => "Share request submitted."
        };
    }

    private static Severity GetShareDecisionSeverity(FolderDto folder) => folder.ShareStatus switch
    {
        Data.Entities.FolderStatus.Approved => Severity.Success,
        Data.Entities.FolderStatus.Rejected => Severity.Warning,
        Data.Entities.FolderStatus.PendingShare when folder.RequiresHumanReview || folder.AppealRequestedAt.HasValue => Severity.Info,
        _ => Severity.Success
    };

