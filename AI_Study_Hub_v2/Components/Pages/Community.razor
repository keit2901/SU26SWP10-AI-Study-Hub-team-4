    private static List<int> BuildSlidingPageNumbers(int total, int current)
    {
        var pages = new List<int>();

        if (total <= 4)
        {
            for (var i = 1; i <= total; i++) pages.Add(i);
            return pages;
        }

        if (current <= 2)
        {
            for (var i = 1; i <= 3; i++) pages.Add(i);
            pages.Add(-1);
            pages.Add(total);
            return pages;
        }

        if (current >= total - 1)
        {
            pages.Add(1);
            pages.Add(-1);
            for (var i = total - 2; i <= total; i++) pages.Add(i);
            return pages;
        }

        for (var i = current - 1; i <= current + 1; i++) pages.Add(i);
        pages.Add(-1);
        pages.Add(total);
        return pages;
    }

