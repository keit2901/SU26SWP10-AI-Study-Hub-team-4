@namespace AI_Study_Hub_v2.Components.Admin.Documents
@using AI_Study_Hub_v2.Dtos
@using Microsoft.AspNetCore.Components
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="resolve-title">
            <div class="resolve-icon"><MudIcon Icon="@Icons.Material.Filled.Rule" /></div>
            <div>
                <span class="resolve-eyebrow">Decision step</span>
                <h2>Review escalated files</h2>
                <p>@Fallback(Escalation.FolderName) · @FormatSource(Escalation.ShareReviewSource)</p>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="resolve-dialog-content">
            <div class="folder-provenance">
                <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
                <div>
                    <strong>@Fallback(Escalation.FolderName)</strong>
                    <span>Folder @Escalation.FolderId</span>
                </div>
                <span class="source-badge">@FormatSource(Escalation.ShareReviewSource)</span>
            </div>

            @if (!CanReviewEscalation)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    Review is blocked because every file must still be pending, current, and available. Close this dialog and refresh the detail page; partial resolution is not allowed.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                    This second step contains decisions only. Preview or download files from the detail page before continuing.
                </MudAlert>

                <div class="decision-list">
                    @foreach (var item in Escalation.Items)
                    {
                        var decision = GetDecision(item.Id);
                        <section class="decision-card" aria-label="Decision for @item.FileNameSnapshot">
                            <div class="decision-card-heading">
                                <div>
                                    <h3>@item.FileNameSnapshot</h3>
                                    <p>@FormatMetadata(item)</p>
                                </div>
                                <span>Generation @item.ModerationGeneration</span>
                            </div>
                            <div class="moderator-note">
                                <span>Moderator note</span>
                                <p>@Fallback(item.RejectReason)</p>
                            </div>
                            <div class="decision-fields">
                                <MudSelect T="string" Value="@decision.Status" ValueChanged="@(status => SetStatus(item.Id, status))"
                                           Label="Decision" Variant="Variant.Outlined" Dense="true" Required="true">
                                    <MudSelectItem Value="@("Approved")">Approve file</MudSelectItem>
                                    <MudSelectItem Value="@("Rejected")">Reject file</MudSelectItem>
                                </MudSelect>
                                <MudTextField T="string" Value="@decision.Response" ValueChanged="@(response => SetResponse(item.Id, response))"
                                              Label="Admin response" Variant="Variant.Outlined" Lines="2"
                                              HelperText="Required when rejecting; optional context when approving."
                                              Required="@(decision.Status == "Rejected")"
                                              Error="@(decision.Status == "Rejected" && string.IsNullOrWhiteSpace(decision.Response))"
                                              ErrorText="Explain why this file is rejected." />
                            </div>
                        </section>
                    }
                </div>

                <div class="atomic-note">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                    <span>All @Escalation.Items.Count decision(s) are submitted together. If the live state changes, the request is rejected and the detail page reloads.</span>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        @if (CanReviewEscalation)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSubmit)" OnClick="Submit"
                       StartIcon="@Icons.Material.Filled.DoneAll">
                Submit @Escalation.Items.Count decision(s)
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<style>
    .resolve-title { display: flex; align-items: center; gap: .75rem; font-family: 'Hanken Grotesk', sans-serif; }
    .resolve-icon { width: 2.5rem; height: 2.5rem; display: grid; place-items: center; border-radius: 11px; color: #fff; background: linear-gradient(145deg, #5e5ce6, #7c70f6 65%, #17a8c3); box-shadow: 0 10px 24px rgba(94, 92, 230, .22); }
    .resolve-eyebrow { color: #6258bd; font-size: .65rem; font-weight: 850; letter-spacing: .1em; text-transform: uppercase; }
    .resolve-title h2 { margin: .05rem 0 0; color: #1d1934; font-size: 1.08rem; font-weight: 850; }
    .resolve-title p { margin: .12rem 0 0; color: #756e88; font-size: .72rem; }
    .resolve-dialog-content { display: grid; gap: .8rem; font-family: 'Hanken Grotesk', sans-serif; }
    .folder-provenance { display: flex; align-items: center; gap: .65rem; padding: .75rem .8rem; border: 1px solid rgba(94, 92, 230, .13); border-radius: 11px; background: rgba(94, 92, 230, .045); }
    .folder-provenance > .mud-icon-root { color: #5e5ce6; }
    .folder-provenance div { display: flex; min-width: 0; flex: 1; flex-direction: column; }
    .folder-provenance strong { color: #241f3d; font-size: .82rem; overflow-wrap: anywhere; }
    .folder-provenance div span { color: #756e88; font-size: .67rem; overflow-wrap: anywhere; }
    .source-badge { padding: .28rem .48rem; border-radius: 999px; background: #ece9ff; color: #5148aa; font-size: .63rem; font-weight: 800; text-transform: uppercase; }
    .decision-list { display: grid; gap: .7rem; max-height: min(54vh, 520px); padding-right: .15rem; overflow-y: auto; }
    .decision-card { padding: .85rem; border: 1px solid #e1deeb; border-radius: 12px; background: #fff; }
    .decision-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: .75rem; }
    .decision-card-heading h3 { margin: 0; color: #211c38; font-size: .85rem; overflow-wrap: anywhere; }
    .decision-card-heading p { margin: .2rem 0 0; color: #756e88; font-size: .68rem; }
    .decision-card-heading > span { flex: 0 0 auto; padding: .25rem .45rem; border-radius: 999px; color: #5148aa; background: #f0eeff; font-size: .62rem; font-weight: 800; }
    .moderator-note { margin-top: .65rem; padding: .55rem .65rem; border-left: 2px solid #7568da; border-radius: 0 8px 8px 0; background: rgba(94, 92, 230, .05); }
    .moderator-note span { color: #756e88; font-size: .61rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
    .moderator-note p { margin: .2rem 0 0; color: #4e485f; font-size: .72rem; white-space: pre-wrap; }
    .decision-fields { display: grid; grid-template-columns: minmax(10rem, .7fr) minmax(14rem, 1.3fr); gap: .7rem; margin-top: .75rem; }
    .atomic-note { display: flex; align-items: flex-start; gap: .5rem; color: #625b74; font-size: .69rem; line-height: 1.4; }
    .atomic-note .mud-icon-root { flex: 0 0 auto; color: #168263; font-size: 1rem; }
    @@media (max-width: 620px) {
        .folder-provenance, .decision-card-heading { align-items: flex-start; flex-direction: column; }
        .decision-fields { grid-template-columns: 1fr; }
        .source-badge { align-self: flex-start; }
    }
</style>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public DocumentEscalationDto Escalation { get; set; } = default!;

    private readonly Dictionary<Guid, ItemDecision> _decisions = new();

    private bool CanReviewEscalation => EscalationDecisionGuard.CanReview(Escalation);

    private bool CanSubmit => CanReviewEscalation
        && Escalation.Items.All(item =>
        {
            var decision = GetDecision(item.Id);
            return decision.Status is "Approved" or "Rejected"
                && (decision.Status != "Rejected" || !string.IsNullOrWhiteSpace(decision.Response));
        });

    protected override void OnParametersSet()
    {
        if (!CanReviewEscalation) return;

        foreach (var item in Escalation.Items)
            _decisions.TryAdd(item.Id, new ItemDecision());
    }

    private ItemDecision GetDecision(Guid itemId) =>
        _decisions.TryGetValue(itemId, out var decision) ? decision : new ItemDecision();

    private void SetStatus(Guid itemId, string status)
    {
        var current = GetDecision(itemId);
        _decisions[itemId] = current with { Status = status };
    }

    private void SetResponse(Guid itemId, string? response)
    {
        var current = GetDecision(itemId);
        _decisions[itemId] = current with { Response = response };
    }

    private void Submit()
    {
        if (!CanSubmit) return;

        MudDialog.Close(DialogResult.Ok(new ResolveEscalationItemsRequest
        {
            Items = Escalation.Items.Select(item =>
            {
                var decision = GetDecision(item.Id);
                return new ResolveEscalationItemRequest
                {
                    ItemId = item.Id,
                    Status = decision.Status,
                    AdminResponse = string.IsNullOrWhiteSpace(decision.Response) ? null : decision.Response.Trim()
                };
            }).ToList()
        }));
    }

    private void Cancel() => MudDialog.Cancel();

    private static string FormatMetadata(DocumentEscalationItemDto item) =>
        $"{Fallback(item.SubjectCode)} · {Fallback(item.Semester)} · {FormatFileSize(item.FileSizeBytes)}";

    private static string FormatFileSize(long? bytes) => bytes switch
    {
        null => "Size not recorded",
        >= 1_048_576 => $"{bytes.Value / 1_048_576d:F1} MB",
        >= 1_024 => $"{bytes.Value / 1_024d:F1} KB",
        _ => $"{bytes.Value} B"
    };

    private static string Fallback(string? value) => string.IsNullOrWhiteSpace(value) ? "Not recorded (legacy)" : value;
    private static string FormatSource(string? source) => string.IsNullOrWhiteSpace(source) ? "Not recorded (legacy)" : source.Replace('_', ' ');

    private sealed record ItemDecision(string Status = "", string? Response = null);
}
