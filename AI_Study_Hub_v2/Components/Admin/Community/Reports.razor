@namespace AI_Study_Hub_v2.Components.Admin.Community
@page "/admin/community-reports"
@layout AdminLayout
@implements IAsyncDisposable
@inject AuthSessionState Session
@inject CommunityApiClient CommunityApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Spacing="4" Class="page-enter">
    <MudPaper Elevation="0" Class="report-header">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="flex-wrap: wrap; gap: 1rem;">
            <div>
                <MudText Typo="Typo.overline" Class="report-kicker">Operations · Moderation</MudText>
                <MudText Typo="Typo.h4">Community reports</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    Review reports submitted against folders published to the Public Hub.
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@RefreshStatus</MudText>
            </div>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@_manualRefreshQueued"
                       OnClick="RefreshAsync">
                @RefreshButtonText
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_error</MudAlert>
    }

    <MudPaper Elevation="0" Class="report-list">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_reports.Count == 0)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Large" Color="Color.Success" />
                <MudText Typo="Typo.h6">No pending reports</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">The Public Hub moderation queue is clear.</MudText>
            </MudStack>
        }
        else
        {
            <MudTable Items="_reports" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Folder</MudTh>
                    <MudTh>Reporter</MudTh>
                    <MudTh>Reason</MudTh>
                    <MudTh>Submitted</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Folder">
                        <MudText Typo="Typo.subtitle2">@context.FolderName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.FolderId</MudText>
                    </MudTd>
                    <MudTd DataLabel="Reporter">@context.ReportedByName</MudTd>
                    <MudTd DataLabel="Reason">
                        <MudText Typo="Typo.body2" Style="max-width: 28rem; white-space: normal;">@context.Reason</MudText>
                    </MudTd>
                    <MudTd DataLabel="Submitted">@context.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudButton Size="Size.Small"
                                       Color="Color.Success"
                                       Variant="Variant.Filled"
                                       Disabled="@(_busyReportId == context.Id)"
                                       OnClick="@(() => ReviewAsync(context, "Resolved"))">
                                Resolve
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Color="Color.Warning"
                                       Variant="Variant.Outlined"
                                       Disabled="@(_busyReportId == context.Id)"
                                       OnClick="@(() => ReviewAsync(context, "Dismissed"))">
                                Dismiss
                            </MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</MudStack>

@code {
    private readonly List<CommunityReportDto> _reports = new();
    private bool _loading = true;
    private string? _error;
    private Guid? _busyReportId;
    private bool _hasLoaded;
    private bool _isRefreshing;
    private bool _manualRefreshQueued;
    private DateTimeOffset? _lastSuccessfulRefreshUtc;
    private readonly CancellationTokenSource _lifetimeCts = new();
    private readonly SemaphoreSlim _refreshGate = new(1, 1);
    private readonly PeriodicTimer _pollTimer = new(TimeSpan.FromSeconds(30));
    private Task? _pollTask;

    private string RefreshStatus => _lastSuccessfulRefreshUtc is null
        ? "Waiting for the first successful refresh."
        : $"Last refreshed {_lastSuccessfulRefreshUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm:ss}.";
    private string RefreshButtonText => _manualRefreshQueued
        ? "Refresh queued"
        : _isRefreshing ? "Refreshing..." : "Refresh";

    protected override void OnInitialized()
    {
        Session.OnChange += HandleSessionChanged;
        _pollTask = PollAsync();
        if (Session.IsAuthenticated)
        {
            _ = LoadAsync();
        }
    }

    private void HandleSessionChanged()
    {
        if (Session.IsAuthenticated)
        {
            _ = InvokeAsync(() => LoadAsync());
        }
    }

    private async Task RefreshAsync()
    {
        _manualRefreshQueued = _isRefreshing;
        await InvokeAsync(StateHasChanged);
        try
        {
            await LoadAsync(waitForActiveRefresh: true);
        }
        finally
        {
            _manualRefreshQueued = false;
            if (!_lifetimeCts.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadAsync(bool waitForActiveRefresh = false)
    {
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            return;
        }

        bool entered;
        try
        {
            entered = await _refreshGate.WaitAsync(
                waitForActiveRefresh ? Timeout.InfiniteTimeSpan : TimeSpan.Zero,
                _lifetimeCts.Token);
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            return;
        }

        if (!entered)
        {
            return;
        }

        _loading = !_hasLoaded;
        _isRefreshing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var rows = await CommunityApi.GetPendingReportsAsync(Session.AccessToken, _lifetimeCts.Token);
            _reports.Clear();
            _reports.AddRange(rows);
            _hasLoaded = true;
            _lastSuccessfulRefreshUtc = DateTimeOffset.UtcNow;
            _error = null;
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            // Expected while disposal cancels a pending refresh.
        }
        catch (Exception ex)
        {
            _error = _hasLoaded
                ? $"Unable to refresh community reports. Showing the last successful data: {ex.Message}"
                : $"Unable to load community reports: {ex.Message}";
        }
        finally
        {
            _loading = false;
            _isRefreshing = false;
            _refreshGate.Release();
            if (!_lifetimeCts.IsCancellationRequested)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ReviewAsync(CommunityReportDto report, string decision)
    {
        var dialog = await DialogService.ShowAsync<ResolveReportDialog>(
            $"{decision} report",
            new DialogParameters<ResolveReportDialog>
            {
                { item => item.FolderName, report.FolderName },
                { item => item.ReporterReason, report.Reason },
                { item => item.Decision, decision },
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string resolution)
        {
            return;
        }

        _busyReportId = report.Id;
        try
        {
            await CommunityApi.ResolveReportAsync(
                Session.AccessToken!,
                report.Id,
                decision,
                resolution,
                _lifetimeCts.Token);
            _reports.Remove(report);
            Snackbar.Add(
                decision == "Resolved" ? "Report resolved." : "Report dismissed.",
                decision == "Resolved" ? Severity.Success : Severity.Info);
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            // Expected when component disposal cancels a report resolution.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Review failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busyReportId = null;
        }
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _pollTimer.WaitForNextTickAsync(_lifetimeCts.Token))
            {
                await InvokeAsync(() => LoadAsync());
            }
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested)
        {
            // Expected while the component is disposed.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Session.OnChange -= HandleSessionChanged;
        _lifetimeCts.Cancel();
        _pollTimer.Dispose();
        if (_pollTask is not null)
        {
            await _pollTask;
        }
        await _refreshGate.WaitAsync();
        _refreshGate.Dispose();
    }
}

<style>
    .report-header,
    .report-list {
        padding: 1.25rem;
        border-radius: 10px;
        border: 1px solid rgba(190, 196, 255, .14);
        background: rgba(18, 18, 31, .9);
    }

    .report-header {
        background: rgba(18, 18, 31, .9);
        border-left: 3px solid #72dcf2;
    }

    .report-kicker { color: #72dcf2 !important; letter-spacing: .09em; }

    @@media (max-width: 600px) { .report-header, .report-list { padding: 1rem; } }
</style>
