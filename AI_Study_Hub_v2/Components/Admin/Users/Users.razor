@namespace AI_Study_Hub_v2.Components.Admin.Users
@page "/admin/users"
@layout AdminLayout
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using AI_Study_Hub_v2.Components.Admin.Shared
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IRoleCatalogService Roles
@inject AuthSessionState Session
@inject AdminApiClient AdminApi

<div class="admin-users-page page-enter">
    <!-- Page header -->
    <div class="d-flex justify-space-between align-center mb-6 flex-wrap" style="gap: 1rem;">
        <div>
            <div class="admin-page-kicker">Operations · Access</div>
            <h2 class="text-[32px] font-extrabold text-on-background" style="font-size: 28px; font-weight: 800; color: #191c1e; font-family: 'Hanken Grotesk', sans-serif; line-height: 1.2;">Users &amp; Permissions</h2>
            <p class="text-body-md text-on-surface-variant mt-1" style="font-size: 14px; color: #575e72; font-family: 'Hanken Grotesk', sans-serif;">Review accounts, roles, access status, and daily token limits.</p>
        </div>
    </div>

    <!-- Tab Switcher -->
    <div class="d-flex mb-6" style="gap: 0; border-bottom: 2px solid #e0e3e5;">
        <button class="tab-btn @(!_showHighUsageTab ? "tab-active" : "")" @onclick="() => _showHighUsageTab = false"
                style="padding: 10px 20px; border: none; background: none; font-size: 14px; font-weight: 600; cursor: pointer; border-bottom: @(!_showHighUsageTab ? "2px solid #4648d4" : "2px solid transparent"); color: @(!_showHighUsageTab ? "#4648d4" : "#767586"); margin-bottom: -2px;">
            All Users
        </button>
        <button class="tab-btn @(_showHighUsageTab ? "tab-active" : "")" @onclick="() => _showHighUsageTab = true"
                style="padding: 10px 20px; border: none; background: none; font-size: 14px; font-weight: 600; cursor: pointer; border-bottom: @(_showHighUsageTab ? "2px solid #4648d4" : "2px solid transparent"); color: @(_showHighUsageTab ? "#4648d4" : "#767586"); margin-bottom: -2px;">
            High-usage Users
        </button>
    </div>

    @if (_showHighUsageTab)
    {
        @* High-usage Users view *@
        @if (!_users.Any(u => u.TokenUsagePercent >= 85))
        {
            <div class="d-flex flex-column align-center justify-center py-10" style="text-align: center; gap: 0.75rem;">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 32px; color: #16a34a;" />
                <div class="font-bold text-lg" style="color: #191c1e;">No high-usage users yet.</div>
                <div class="text-sm" style="color: #767586; max-width: 360px;">Users will appear here when they reach 85% of their daily token quota.</div>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined">
                Users at or above 85% of daily token quota. Review and adjust quotas as needed.
            </MudAlert>

            <div class="document-table-container">
                <table class="document-table">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Role</th>
                            <th>Used Today</th>
                            <th>Quota</th>
                            <th>Usage %</th>
                            <th>Remaining</th>
                            <th>Status</th>
                            <th style="width: 80px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in _users.Where(u => u.TokenUsagePercent >= 85).OrderByDescending(u => u.TokenUsagePercent))
                        {
                            <tr>
                                <td>
                                    <button type="button" class="user-detail-link" @onclick="@(() => OpenDetails(user))" aria-label="View details for @user.FullName">
                                    <div class="doc-name-cell">
                                        <div class="doc-avatar pdf" style="width: 32px; height: 32px; font-size: 12px;">
                                            @user.Initials
                                        </div>
                                        <div>
                                            <div class="doc-title-text" style="font-size: 13px;">@user.FullName</div>
                                            <div class="doc-meta-text">@user.Email</div>
                                        </div>
                                    </div>
                                    </button>
                                </td>
                                <td><span class="subject-pill">@user.Role</span></td>
                                <td>@user.TokensUsedToday.ToString("N0")</td>
                                <td>@user.DailyTokenQuota.ToString("N0")</td>
                                <td>
                                    <div class="d-flex align-center" style="gap: 6px;">
                                        <span style="font-weight: 700; font-size: 13px;">@($"{user.TokenUsagePercent:0}%")</span>
                                        <div style="flex: 1; height: 6px; background: #eceef0; border-radius: 3px; min-width: 60px;">
                                            <div style="height: 100%; border-radius: 3px; background: @(user.TokenUsagePercent >= 95 ? "#ba1a1a" : "#d97706"); width: @($"{user.TokenUsagePercent}%");"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>@((user.DailyTokenQuota - user.TokensUsedToday).ToString("N0"))</td>
                                <td>
                                    <span class="moderation-badge @(user.TokenUsagePercent >= 95 ? "rejected" : "pending")" style="background-color: @(user.TokenUsagePercent >= 95 ? "rgba(186,26,26,0.08)" : "rgba(217,119,6,0.08)"); color: @(user.TokenUsagePercent >= 95 ? "#ba1a1a" : "#d97706");">
                                        @(user.TokenUsagePercent >= 95 ? "Critical" : "Warning")
                                    </span>
                                </td>
                                <td>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => OpenQuotaSheet(user))" Style="text-transform:none;font-size:11px;">
                                        Adjust quota
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
    <!-- KPI Grid -->
    <div class="kpi-grid-container mb-6">
        <!-- Card 1: Users Loaded -->
        @{
            var activeAdminCount = _users.Count(u => u.Role.Equals(AdminRole, StringComparison.OrdinalIgnoreCase) && u.IsActive);
            var inactiveCount = _users.Count(u => !u.IsActive);
        }
        <div class="kpi-card-custom">
            <div class="d-flex justify-space-between align-start" style="width: 100%;">
                <div>
                    <span class="kpi-label">USERS SHOWN</span>
                    <div class="kpi-value">@_users.Count.ToString("N0")</div>
                    @if (_users.Count == 0)
                    {
            <span class="kpi-subtext mt-2">No users loaded yet.</span>
                    }
                </div>
                <div class="kpi-icon-circle blue">
                    <MudIcon Icon="@Icons.Material.Outlined.People" />
                </div>
            </div>
        </div>

        <!-- Card 2: Active Admins -->
        <div class="kpi-card-custom">
            <div class="d-flex justify-space-between align-start" style="width: 100%;">
                <div>
                    <span class="kpi-label">ACTIVE ADMINS</span>
                    <div class="kpi-value">@activeAdminCount.ToString("N0")</div>
                    <span class="kpi-subtext mt-2">@(activeAdminCount == 0 ? "No active admins yet." : "Privileged accounts")</span>
                </div>
                <div class="kpi-icon-circle purple">
                    <MudIcon Icon="@Icons.Material.Outlined.Shield" />
                </div>
            </div>
        </div>

        <!-- Card 3: Roles loaded -->
        <div class="kpi-card-custom">
            <div class="d-flex justify-space-between align-start" style="width: 100%;">
                <div>
                    <span class="kpi-label">ROLES LOADED</span>
                    <div class="kpi-value">@_roles.Count.ToString("N0")</div>
                    <span class="kpi-subtext mt-2">@(_roles.Count == 0 ? "No roles available" : "From the role catalog")</span>
                </div>
                <div class="kpi-icon-circle slate">
                    <MudIcon Icon="@Icons.Material.Outlined.AdminPanelSettings" />
                </div>
            </div>
        </div>

        <!-- Card 4: Inactive Users -->
        <div class="kpi-card-custom">
            <div class="d-flex justify-space-between align-start" style="width: 100%;">
                <div>
                    <span class="kpi-label">INACTIVE USERS</span>
                    <div class="kpi-value">@inactiveCount.ToString("N0")</div>
                    <span class="kpi-subtext mt-2">@(inactiveCount == 0 ? "No inactive users yet." : "Deactivated accounts")</span>
                </div>
                <div class="kpi-icon-circle red">
                    <MudIcon Icon="@Icons.Material.Outlined.Block" />
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Layout (Table & Widgets) -->
    <MudGrid>
        <!-- Table Column -->
        <MudItem xs="12" lg="8">
            <!-- Search & Filters -->
            <div class="filter-row-custom mb-6">
                <div class="search-input-wrapper">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" />
                    <input type="text" placeholder="Search by name or email" @bind="SearchText" @bind:event="oninput" class="search-input" />
                </div>
                
                <select class="filter-select" value="@_selectedRole" @onchange="OnRoleSelectChanged">
                    <option value="">All Roles</option>
                    @foreach (var role in AvailableRoleNames)
                    {
                        <option value="@role">@role</option>
                    }
                </select>

                <select class="filter-select" value="@_selectedStatus" @onchange="OnStatusSelectChanged">
                    <option value="">Status</option>
                    <option value="@ActiveStatus">Active</option>
                    <option value="@InactiveStatus">Inactive</option>
                </select>

                @{
                    var filterIconColor = HasActiveFilters ? "#575e72" : "#c7c6d5";
                    var filterIconStyle = $"font-size: 18px; color: {filterIconColor};";
                }
                <button class="filter-btn @(HasActiveFilters ? "" : "muted")" @onclick="ClearFilters" disabled="@(!HasActiveFilters)" title="@(HasActiveFilters ? "Clear all filters" : "No filters active")">
                    <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff" Style="@filterIconStyle" />
                </button>
            </div>

            <!-- Custom Table -->
            <div class="users-table-container mb-6">
                @if (_isLoading)
                {
                    <div class="pa-6">
                        <MudSkeleton Height="44px" Animation="Animation.Wave" />
                        <MudSkeleton Height="44px" Animation="Animation.Wave" />
                        <MudSkeleton Height="44px" Animation="Animation.Wave" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="ma-4">
                        @_errorMessage
                    </MudAlert>
                }
                else if (!FilteredUsers.Any())
                {
                    <div class="d-flex flex-column align-center justify-center py-10" style="text-align: center; gap: 0.5rem;">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                        <div class="font-bold text-lg" style="color: #191c1e;">No users match the current filters.</div>
                        @if (HasActiveFilters)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="ClearFilters" Style="text-transform: none; font-size: 12px; margin-top: 0.5rem;">Clear filters</MudButton>
                        }
                    </div>
                }
                else
                {
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th>USER</th>
                                <th>ROLE</th>
                                <th>CREATED</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in PagedFilteredUsers)
                            {
                                <tr class="user-row"
                                    tabindex="0"
                                    role="link"
                                    aria-label="View details for @user.FullName"
                                    @onclick="@(() => OpenDetails(user))"
                                    @onkeydown="@(args => HandleUserRowKeyDown(args, user))">
                                    <td>
                                        <div class="d-flex align-center" style="gap: 0.75rem;">
                                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                                            {
                                                <img src="@user.AvatarUrl" class="user-avatar-img" alt="" />
                                            }
                                            else
                                            {
                                                <span class="user-avatar-initials @(user.Role.ToLower())">@user.Initials</span>
                                            }
                                            <div>
                                                <div class="user-name">
                                                    @user.FullName
                                                    @if (IsCurrentAdmin(user))
                                                    {
                                                        <MudTooltip Text="Current signed-in administrator">
                                                            <span class="user-badge-you">You</span>
                                                        </MudTooltip>
                                                    }
                                                </div>
                                                <div class="user-email">@user.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="role-badge @(user.Role.ToLower())">@user.Role.ToUpper()</span>
                                    </td>
                                    <td>
                                        <time class="last-active-text"
                                              datetime="@user.CreatedAt.ToUniversalTime().ToString("O")"
                                              title="@FormatExactTimestamp(user.CreatedAt)">@FormatDate(user.CreatedAt)</time>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="users-table-footer">
                        <span class="footer-count">Total @FilteredUsersCount user@(FilteredUsersCount == 1 ? string.Empty : "s")</span>
                        @if (TotalUserPages > 1)
                        {
                            <div class="footer-pagination">
                                <button type="button" class="pag-btn" disabled="@(DisplayUserPage <= 1)" @onclick="() => GoToUserPage(DisplayUserPage - 1)">Prev</button>
                                @foreach (var page in GetUserPageNumbers())
                                {
                                    if (page == -1)
                                    {
                                        <span class="footer-page-ellipsis">...</span>
                                    }
                                    else
                                    {
                                        var current = page;
                                        <button type="button" class="pag-btn @(current == DisplayUserPage ? "active" : "")" @onclick="() => GoToUserPage(current)">@current</button>
                                    }
                                }
                                <button type="button" class="pag-btn" disabled="@(DisplayUserPage >= TotalUserPages)" @onclick="() => GoToUserPage(DisplayUserPage + 1)">Next</button>
                                <input type="text"
                                       class="footer-page-jump-input"
                                       placeholder="Page..."
                                       value="@_pageJumpInput"
                                       @oninput="HandlePageJumpInput"
                                       @onkeydown="HandlePageJumpKeyDown" />
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_roles.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-6">
                    No roles are currently available. Role changes are disabled until the role catalog loads.
                </MudAlert>
            }

            <!-- Guardrail alert banner -->
            <div class="p-3 rounded-lg d-flex gap-2 align-center mb-6" style="background-color: #fffdf5; border: 1px solid rgba(245, 158, 11, 0.15); border-radius: 0.5rem;">
                <MudIcon Icon="@Icons.Material.Filled.Info" Style="color: #d97706; font-size: 18px; flex-shrink: 0;" />
                <span style="color: #92400e; font-size: 12px; line-height: 1.4;">
                    <strong>Guardrail:</strong> Admins cannot deactivate or demote themselves. All role, status and quota changes are audited.
                </span>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Warning" Style="flex-shrink: 0; text-transform: none; font-size: 11px; margin-left: auto;" OnClick="NavigateToAuditLogs">
                    View audit logs
                </MudButton>
            </div>
        </MudItem>

        <!-- Widgets Column -->
        <MudItem xs="12" lg="4">
            <div class="d-flex flex-column" style="gap: 1.5rem;">
                <!-- Widget 1: Role catalog -->
                <div class="widget-card">
                    <div class="d-flex align-center justify-space-between mb-4">
                        <div class="d-flex align-center" style="gap: 8px;">
                            <MudIcon Icon="@Icons.Material.Outlined.Shield" Style="color: #4648d4; font-size: 20px;" />
                            <span style="font-size: 16px; font-weight: 700; color: #191c1e;">Role catalog</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column py-2" style="gap: 0.25rem;">
                        <span style="font-size: 20px; font-weight: 800; color: #191c1e;">@_roles.Count</span>
                        <span style="font-size: 12px; color: #767586;">Configured roles</span>
                        @if (_roles.Count > 0)
                        {
                            <span class="widget-detail-text">@RoleCatalogNames</span>
                        }
                    </div>
                </div>

                <!-- Widget 2: Document inventory -->
                <div class="widget-card dark">
                    <div class="d-flex align-center" style="gap: 8px; margin-bottom: 16px;">
                        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Style="color: #10b981; font-size: 20px;" />
                        <span style="font-size: 16px; font-weight: 700; color: #ffffff;">Document inventory</span>
                    </div>
                    <div class="d-flex flex-column py-2" style="gap: 0.25rem;">
                        <span style="font-size: 20px; font-weight: 800; color: #ffffff;">@(TotalDocumentCount > 0 ? $"{TotalDocumentCount:N0} documents" : "No documents")</span>
                        <span style="font-size: 12px; color: #c7c6d5;">@(TotalDocumentCount > 0 ? "Owned by loaded users" : "Loaded users have not uploaded any documents.")</span>
                    </div>
                </div>

                <!-- Widget 3: Daily token usage -->
                <div class="widget-card blue">
                    <div class="d-flex align-center" style="gap: 8px; margin-bottom: 12px;">
                        <MudIcon Icon="@Icons.Material.Filled.FlashOn" Style="color: #ffffff; font-size: 20px;" />
                        <span style="font-size: 16px; font-weight: 700; color: #ffffff;">Daily token usage</span>
                    </div>
                    <div class="d-flex flex-column py-2" style="gap: 0.4rem;">
                        <span style="font-size: 16px; font-weight: 800; color: #ffffff;">@TotalTokensUsedToday.ToString("N0") / @TotalDailyTokenQuota.ToString("N0") tokens</span>
                        <span style="font-size: 12px; color: #c7d2fe;">@(TotalTokensUsedToday > 0 ? "Used today across loaded users." : "No token usage recorded today.")</span>
                        <MudProgressLinear Value="@TotalTokenUsagePercent" Min="0" Max="100" Size="Size.Small" Rounded="true" Color="Color.Info" Class="token-usage-progress" />
                    </div>
                </div>
            </div>
        </MudItem>
    </MudGrid>
    }
</div>

<EntitySheet Open="@_quotaSheetOpen"
             OpenChanged="@(value => _quotaSheetOpen = value)"
             Title="Daily token quota"
             Subtitle="Configure UC16 per-user daily token limits and warning state."
             Width="520px">
    <ChildContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Saving updates this user's daily token quota through the administrator API.
            </MudAlert>
            <MudTextField Value="@_quotaEdit.UserName" Label="User" Variant="Variant.Outlined" ReadOnly="true" />
            <MudNumericField T="int" Value="@_quotaEdit.DailyTokenQuota" ValueChanged="OnQuotaValueChanged" Label="Daily token quota" Variant="Variant.Outlined" Min="1000" Step="1000" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Current usage: @_quotaEdit.TokensUsedToday.ToString("N0") tokens today</MudText>
            <MudProgressLinear Value="@_quotaEdit.UsagePercent" Color="@GetQuotaProgressColor(_quotaEdit.UsagePercent)" Rounded="true" Size="Size.Large" />
            <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuotaPreset(25000))">Student preset</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuotaPreset(75000))">Admin preset</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuotaPreset(150000))">Temporary boost</MudButton>
            </MudStack>
            @if (_quotaEdit.UsagePercent >= 100)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled">This user has exceeded the proposed quota and should be throttled or boosted.</MudAlert>
            }
            else if (_quotaEdit.UsagePercent >= 85)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">This user is approaching the proposed quota.</MudAlert>
            }
        </MudStack>
    </ChildContent>
    <FooterContent>
        <MudButton Variant="Variant.Text" OnClick="CloseQuotaSheetAsync">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveQuotaAsync">
            Save quota
        </MudButton>
    </FooterContent>
</EntitySheet>

@code {
    private const string AdminRole = "Admin";
    private const string ActiveStatus = "Active";
    private const string InactiveStatus = "Inactive";
    private const string QuotaNormal = "Normal";
    private const string QuotaWarning = "Warning";
    private const string QuotaExceeded = "Exceeded";
    private const int UserPageSize = 10;
    private readonly List<UserRow> _users = new();
    private readonly List<RoleOption> _roles = new();
    private bool _showHighUsageTab;
    private bool _isLoading = true;
    private bool _quotaSheetOpen;
    private string _searchText = string.Empty;
    private string? _selectedRole;
    private string? _selectedStatus;
    private string? _selectedQuotaRisk;
    private string? _errorMessage;
    private Guid? _processingUserId;
    private int _currentPage = 1;
    private string _pageJumpInput = string.Empty;
    private QuotaEditModel _quotaEdit = new();

    private string SearchText
    {
        get => _searchText;
        set
        {
            var nextValue = value ?? string.Empty;
            if (string.Equals(_searchText, nextValue, StringComparison.Ordinal))
            {
                return;
            }

            _searchText = nextValue;
            _currentPage = 1;
            _pageJumpInput = string.Empty;
        }
    }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(SearchText)
        || !string.IsNullOrWhiteSpace(_selectedRole)
        || !string.IsNullOrWhiteSpace(_selectedStatus)
        || !string.IsNullOrWhiteSpace(_selectedQuotaRisk);

    private IEnumerable<UserRow> FilteredUsers => _users
        .Where(MatchesRole)
        .Where(MatchesStatus)
        .Where(MatchesQuotaRisk)
        .Where(MatchesSearch)
        .OrderByDescending(user => IsCurrentAdmin(user))
        .ThenByDescending(user => user.TokenUsagePercent)
        .ThenBy(user => user.FullName);

    private IReadOnlyList<string> AvailableRoleNames => _roles
        .Select(role => role.RoleName)
        .Where(role => !string.IsNullOrWhiteSpace(role))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(role => role.Equals(AdminRole, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
        .ThenBy(role => role)
        .ToList();

    private int FilteredUsersCount => FilteredUsers.Count();

    private int TotalUserPages => Math.Max(1, (int)Math.Ceiling(FilteredUsersCount / (double)UserPageSize));

    private int DisplayUserPage => Math.Clamp(_currentPage, 1, TotalUserPages);

    private IEnumerable<UserRow> PagedFilteredUsers => FilteredUsers
        .Skip((DisplayUserPage - 1) * UserPageSize)
        .Take(UserPageSize);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRolesAsync();
            await LoadUsersAsync();

            var uri = new Uri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (query["quota"] == "warning")
            {
                _showHighUsageTab = true;
                _selectedQuotaRisk = QuotaWarning;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load users or roles: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadUsersAsync()
    {
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken))
        {
            _errorMessage = "Authentication required to load users.";
            return;
        }

        var users = await AdminApi.ListUsersAsync(Session.AccessToken);
        _users.Clear();
        foreach (var dto in users)
        {
            _users.Add(new UserRow
            {
                Id = dto.Id,
                FullName = string.IsNullOrWhiteSpace(dto.FullName) ? dto.Username : dto.FullName,
                Email = dto.Username,
                Role = dto.Role,
                IsActive = dto.IsActive,
                DailyTokenQuota = (int)dto.DailyTokenQuota,
                TokensUsedToday = (int)dto.TokensUsedToday,
                DocumentCount = dto.DocumentCount,
                CreatedAt = dto.CreatedAt.UtcDateTime
            });
        }
    }

    private async Task LoadRolesAsync()
    {
        var roles = await Roles.ListAsync();
        _roles.Clear();
        _roles.AddRange(roles.Select(role => new RoleOption(role.RoleName, role.Description)));

    }

    private void ClearFilters()
    {
        SearchText = string.Empty;
        _selectedRole = null;
        _selectedStatus = null;
        _selectedQuotaRisk = null;
        _currentPage = 1;
        _pageJumpInput = string.Empty;
    }

    private void GoToUserPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalUserPages);
    }

    private List<int> GetUserPageNumbers() => BuildSlidingPageNumbers(TotalUserPages, DisplayUserPage);

    private static List<int> BuildSlidingPageNumbers(int total, int current)
    {
        var pages = new List<int>();

        if (total <= 4)
        {
            for (var i = 1; i <= total; i++) pages.Add(i);
            return pages;
        }

        if (current <= 2)
        {
            for (var i = 1; i <= 3; i++) pages.Add(i);
            pages.Add(-1);
            pages.Add(total);
            return pages;
        }

        if (current >= total - 1)
        {
            pages.Add(1);
            pages.Add(-1);
            for (var i = total - 2; i <= total; i++) pages.Add(i);
            return pages;
        }

        for (var i = current - 1; i <= current + 1; i++) pages.Add(i);
        pages.Add(-1);
        pages.Add(total);
        return pages;
    }

    private void HandlePageJumpInput(ChangeEventArgs e)
    {
        _pageJumpInput = e.Value?.ToString()?.Trim() ?? string.Empty;
    }

    private void HandlePageJumpKeyDown(KeyboardEventArgs e)
    {
        if (string.Equals(e.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            GoToPageJump();
        }
    }

    private void GoToPageJump()
    {
        if (int.TryParse(_pageJumpInput, out var page))
        {
            GoToUserPage(page);
        }

        _pageJumpInput = string.Empty;
    }

    private bool MatchesRole(UserRow user)
    {
        return string.IsNullOrWhiteSpace(_selectedRole)
            || user.Role.Equals(_selectedRole, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesStatus(UserRow user)
    {
        return _selectedStatus switch
        {
            ActiveStatus => user.IsActive,
            InactiveStatus => !user.IsActive,
            _ => true
        };
    }

    private bool MatchesQuotaRisk(UserRow user)
    {
        return _selectedQuotaRisk switch
        {
            QuotaNormal => user.TokenUsagePercent < 85,
            QuotaWarning => user.TokenUsagePercent >= 85 && user.TokenUsagePercent < 100,
            QuotaExceeded => user.TokenUsagePercent >= 100,
            _ => true
        };
    }

    private bool MatchesSearch(UserRow user)
    {
        if (string.IsNullOrWhiteSpace(SearchText))
        {
            return true;
        }

        var text = SearchText.Trim();
        return user.FullName.Contains(text, StringComparison.OrdinalIgnoreCase)
            || user.Email.Contains(text, StringComparison.OrdinalIgnoreCase);
    }

    private void OpenDetails(UserRow user)
    {
        Navigation.NavigateTo($"/admin/users/{user.Id}");
    }

    private void HandleUserRowKeyDown(KeyboardEventArgs args, UserRow user)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            OpenDetails(user);
        }
    }

    private void NavigateToAuditLogs()
    {
        Navigation.NavigateTo("/admin/audit-logs");
    }

    private void OpenQuotaSheet(UserRow user)
    {
        _quotaEdit = QuotaEditModel.FromUser(user);
        _quotaSheetOpen = true;
    }

    private Task CloseQuotaSheetAsync()
    {
        _quotaSheetOpen = false;
        _quotaEdit = new QuotaEditModel();
        return Task.CompletedTask;
    }

    private void OnQuotaValueChanged(int value)
    {
        _quotaEdit.DailyTokenQuota = value;
    }

    private void SetQuotaPreset(int value)
    {
        _quotaEdit.DailyTokenQuota = value;
    }

    private async Task SaveQuotaAsync()
    {
        if (_quotaEdit.DailyTokenQuota <= 0)
        {
            Snackbar.Add("Daily token quota must be greater than zero.", Severity.Error);
            return;
        }

        var user = _users.FirstOrDefault(item => item.Id == _quotaEdit.UserId);
        if (user is null)
        {
            Snackbar.Add("User no longer exists in the current result set.", Severity.Error);
            return;
        }

        if (_quotaEdit.DailyTokenQuota < user.TokensUsedToday)
        {
            var parameters = new DialogParameters
            {
                ["Title"] = "Quota below current usage",
                ["Message"] = $"The proposed quota is below today's usage for {user.FullName}. The user may be throttled immediately.",
                ["ConfirmText"] = "Save quota",
                ["ConfirmColor"] = Color.Warning,
                ["IconColor"] = Color.Warning,
                ["Icon"] = Icons.Material.Filled.DataUsage
            };

            var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm quota change", parameters);
            var result = await dialog.Result;
            if (result is not { Canceled: false })
            {
                return;
            }
        }

        _processingUserId = user.Id;
        try
        {
            var token = Session.AccessToken;
            if (string.IsNullOrWhiteSpace(token))
            {
                Snackbar.Add("Authentication required. Please log in again.", Severity.Error);
                return;
            }

            await AdminApi.UpdateQuotaAsync(token, user.Id, _quotaEdit.DailyTokenQuota);
            _quotaSheetOpen = false;
            await LoadUsersAsync();
            Snackbar.Add($"Daily token quota updated for {user.FullName}. Audit log entry queued.", Severity.Success);
        }
        catch (DocumentApiException ex)
        {
            Snackbar.Add($"Failed to update quota: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _processingUserId = null;
        }
    }

    private bool IsCurrentAdmin(UserRow user) => user.Id == (Session.CurrentUser?.Id ?? Guid.Empty);

    private static Color GetQuotaProgressColor(double usagePercent)
    {
        return usagePercent >= 100 ? Color.Error : usagePercent >= 85 ? Color.Warning : Color.Success;
    }

    private int TotalDocumentCount => _users.Sum(user => user.DocumentCount);
    private long TotalTokensUsedToday => _users.Sum(user => (long)user.TokensUsedToday);
    private long TotalDailyTokenQuota => _users.Sum(user => (long)user.DailyTokenQuota);
    private double TotalTokenUsagePercent => TotalDailyTokenQuota == 0
        ? 0
        : TotalTokensUsedToday * 100d / TotalDailyTokenQuota;
    private string RoleCatalogNames => string.Join(" • ", AvailableRoleNames);

    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("MMM d, yyyy");

    private static string FormatExactTimestamp(DateTime value) => value.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm:ss tt zzz");

    private Task OnRoleSelectChanged(ChangeEventArgs e)
    {
        _selectedRole = e.Value?.ToString();
        _currentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnStatusSelectChanged(ChangeEventArgs e)
    {
        _selectedStatus = e.Value?.ToString();
        _currentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private sealed record RoleOption(string RoleName, string? Description);

    private sealed class UserRow
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string AvatarUrl { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public bool IsActive { get; set; }
        public int DailyTokenQuota { get; set; }
        public int TokensUsedToday { get; set; }
        public int DocumentCount { get; set; }

        public double TokenUsagePercent => DailyTokenQuota == 0 ? 0 : TokensUsedToday * 100d / DailyTokenQuota;

        public string Initials => GetInitials(FullName, Email);
    }

    private static string GetInitials(string? fullName, string? email)
    {
        var initials = string.Concat((fullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]))
            .ToUpperInvariant();

        return string.IsNullOrEmpty(initials)
            ? (email ?? string.Empty).Trim().FirstOrDefault().ToString().ToUpperInvariant()
            : initials;
    }

    private sealed class QuotaEditModel
    {
        public Guid UserId { get; set; }
        public string UserName { get; set; } = string.Empty;
        public int DailyTokenQuota { get; set; } = 25_000;
        public int TokensUsedToday { get; set; }
        public double UsagePercent => DailyTokenQuota == 0 ? 0 : TokensUsedToday * 100d / DailyTokenQuota;

        public static QuotaEditModel FromUser(UserRow user)
        {
            return new QuotaEditModel
            {
                UserId = user.Id,
                UserName = $"{user.FullName} ({user.Email})",
                DailyTokenQuota = user.DailyTokenQuota,
                TokensUsedToday = user.TokensUsedToday
            };
        }
    }
}

