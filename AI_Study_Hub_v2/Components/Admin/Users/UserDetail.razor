@namespace AI_Study_Hub_v2.Components.Admin.Users
@page "/admin/users/{Id:guid}"
@layout AdminLayout
@using Microsoft.AspNetCore.Components
@using MudBlazor
@using AI_Study_Hub_v2.Components.Admin.Shared
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AdminApiClient AdminApi
@inject IRoleCatalogService Roles
@inject AuthSessionState Session

@if (_isLoading)
{
    <MudStack Spacing="3" Class="page-enter">
        <MudSkeleton Height="120px" Animation="Animation.Wave" />
        <MudSkeleton Height="360px" Animation="Animation.Wave" />
    </MudStack>
}
else if (!string.IsNullOrWhiteSpace(_errorMessage) || _user is null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
        @_errorMessage
    </MudAlert>
}
else
{
    <MudStack Spacing="4" Class="user-detail-page page-enter">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="flex-wrap: wrap; gap: 1rem;">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Size="Size.Large" Color="Color.Primary">@_user.Initials</MudAvatar>
                <div>
                    <MudText Typo="Typo.overline" Class="detail-kicker">Account · Access</MudText>
                    <MudText Typo="Typo.h4">@_user.FullName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_user.Email</MudText>
                </div>
            </MudStack>
            <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToUsers">Back</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block" Disabled="@(!_user.IsActive)" OnClick="DeactivateAsync">Deactivate</MudButton>
            </MudStack>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="detail-card">
                    <MudText Typo="Typo.caption">Role</MudText>
                    <MudText Typo="Typo.h5">@_user.Role</MudText>
                    <MudDivider Class="my-3" />
                    <MudStack Spacing="2">
                        <MudSelect T="string"
                                   Label="Change role"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   @bind-Value="_selectedRole"
                                   Disabled="@(_isRolesLoading || _isUpdatingRole || _roles.Count == 0)">
                            @foreach (var role in _roles)
                            {
                                <MudSelectItem T="string" Value="@role">@role</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                                   Disabled="@RoleChangeDisabled"
                                   OnClick="ChangeRoleAsync">
                            @(_isUpdatingRole ? "Updating role..." : "Save role change")
                        </MudButton>
                        @if (_isRolesLoading || _isUpdatingRole)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        @if (!string.IsNullOrWhiteSpace(_roleCatalogError))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">@_roleCatalogError</MudText>
                        }
                        else if (IsSelfAdminDemotion)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">You cannot demote your own administrator account.</MudText>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="detail-card">
                    <MudText Typo="Typo.caption">Created</MudText>
                    <MudText Typo="Typo.h5">@FormatDate(_user.CreatedAt)</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="detail-card">
                    <MudText Typo="Typo.caption">Status</MudText>
                    <MudText Typo="Typo.h5">@(_user.IsActive ? "Active" : "Inactive")</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="0" Class="detail-tabs-card">
            <MudList T="string" Dense="true" Class="pa-4">
                <MudListSubheader>Loaded account data</MudListSubheader>
                <MudListItem Text="ID" SecondaryText="@_user.Id.ToString()" />
                <MudListItem Text="Full name" SecondaryText="@_user.FullName" />
                <MudListItem Text="Email" SecondaryText="@_user.Email" />
                <MudListItem Text="Created" SecondaryText="@FormatDateTime(_user.CreatedAt)" />
                <MudListItem Text="Documents" SecondaryText="@_user.DocumentCount.ToString("N0")" />
                <MudListItem Text="Daily token quota" SecondaryText="@_user.DailyTokenQuota.ToString("N0")" />
                <MudListItem Text="Tokens used today" SecondaryText="@_user.TokensUsedToday.ToString("N0")" />
            </MudList>
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private UserDetailRow? _user;
    private readonly List<string> _roles = new();
    private bool _isLoading = true;
    private bool _isRolesLoading;
    private bool _isUpdatingRole;
    private string _selectedRole = string.Empty;
    private string? _roleCatalogError;
    private string? _errorMessage;

    private bool IsSelfAdminDemotion => _user is not null
        && _user.Id == (Session.CurrentUser?.Id ?? Guid.Empty)
        && _user.Role.Equals("Admin", StringComparison.OrdinalIgnoreCase)
        && !_selectedRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);

    private bool RoleChangeDisabled => _user is null
        || _isRolesLoading
        || _isUpdatingRole
        || _roles.Count == 0
        || string.IsNullOrWhiteSpace(_selectedRole)
        || !_roles.Contains(_selectedRole, StringComparer.OrdinalIgnoreCase)
        || _user.Role.Equals(_selectedRole, StringComparison.OrdinalIgnoreCase)
        || IsSelfAdminDemotion;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadRolesAsync();

            if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.AccessToken))
            {
                _errorMessage = "Authentication required.";
                return;
            }

            var users = await AdminApi.ListUsersAsync(Session.AccessToken);
            var dto = users.FirstOrDefault(u => u.Id == Id);
            if (dto is null)
            {
                _errorMessage = "User not found.";
                return;
            }

            _user = new UserDetailRow
            {
                Id = dto.Id,
                FullName = string.IsNullOrWhiteSpace(dto.FullName) ? dto.Username : dto.FullName,
                Email = dto.Username,
                Role = dto.Role,
                CreatedAt = dto.CreatedAt.UtcDateTime,
                IsActive = dto.IsActive,
                DailyTokenQuota = dto.DailyTokenQuota,
                TokensUsedToday = dto.TokensUsedToday,
                DocumentCount = dto.DocumentCount
            };

            _selectedRole = _user.Role;
        }
        catch (DocumentApiException ex)
        {
            _errorMessage = $"Unable to load user detail: {ex.Message}";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load user detail: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadRolesAsync()
    {
        _isRolesLoading = true;
        _roleCatalogError = null;

        try
        {
            var roles = await Roles.ListAsync();
            _roles.Clear();
            _roles.AddRange(roles
                .Select(role => role.RoleName)
                .Where(role => !string.IsNullOrWhiteSpace(role))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(role => role.Equals("Admin", StringComparison.OrdinalIgnoreCase) ? 0 : 1)
                .ThenBy(role => role));

            if (_roles.Count == 0)
            {
                _roleCatalogError = "No database roles are available. Role changes are disabled.";
            }
        }
        catch
        {
            _roles.Clear();
            _roleCatalogError = "The role catalog is unavailable. Role changes are disabled.";
        }
        finally
        {
            _isRolesLoading = false;
        }
    }

    private void BackToUsers() => Navigation.NavigateTo("/admin/users");

    private async Task ChangeRoleAsync()
    {
        if (_user is null || string.IsNullOrWhiteSpace(_selectedRole))
        {
            return;
        }

        if (!_roles.Contains(_selectedRole, StringComparer.OrdinalIgnoreCase))
        {
            Snackbar.Add($"Role '{_selectedRole}' is not present in the database roles list.", Severity.Error);
            return;
        }

        if (IsSelfAdminDemotion)
        {
            Snackbar.Add("You cannot demote your own administrator account.", Severity.Error);
            return;
        }

        if (_user.Role.Equals(_selectedRole, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var token = Session.AccessToken;
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(token))
        {
            Snackbar.Add("Authentication required. Please log in again.", Severity.Error);
            return;
        }

        var previousRole = _user.Role;
        var targetRole = _selectedRole;
        var parameters = new DialogParameters
        {
            ["Title"] = "Change user role",
            ["Message"] = $"Change {_user.FullName} from {previousRole} to {targetRole}? This changes the user's authorization and access permissions.",
            ["ConfirmText"] = "Change role",
            ["ConfirmColor"] = Color.Warning,
            ["IconColor"] = Color.Warning,
            ["Icon"] = Icons.Material.Filled.AdminPanelSettings
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Change user role", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        _isUpdatingRole = true;
        try
        {
            var updated = await AdminApi.UpdateRoleAsync(token, _user.Id, targetRole);
            _user.Role = updated.Role;
            _selectedRole = updated.Role;
            Snackbar.Add($"{_user.FullName} changed from {previousRole} to {_user.Role}.", Severity.Success);
        }
        catch (DocumentApiException ex)
        {
            Snackbar.Add($"Failed to change role: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unexpected error while changing role: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUpdatingRole = false;
        }
    }

    private async Task DeactivateAsync()
    {
        if (_user is null || _user.Id == (Session.CurrentUser?.Id ?? Guid.Empty))
        {
            Snackbar.Add("You cannot deactivate your own account.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["Title"] = "Deactivate user",
            ["Message"] = $"Deactivate {_user.FullName}? This prevents future access until restored.",
            ["ConfirmText"] = "Deactivate",
            ["ConfirmationText"] = _user.Email,
            ["ConfirmColor"] = Color.Error
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Deactivate user", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            try
            {
                var token = Session.AccessToken;
                if (string.IsNullOrWhiteSpace(token))
                {
                    Snackbar.Add("Authentication required.", Severity.Error);
                    return;
                }

                await AdminApi.ToggleActiveAsync(token, _user.Id, false);
                _user.IsActive = false;
                Snackbar.Add($"{_user.FullName} has been deactivated.", Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to deactivate: {ex.Message}", Severity.Error);
            }
        }
    }

    private static string FormatDate(DateTime value) => value.ToString("MMM dd, yyyy");

    private static string FormatDateTime(DateTime value) => value.ToLocalTime().ToString("MMM dd, yyyy HH:mm");

    private sealed class UserDetailRow
    {
        public Guid Id { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public bool IsActive { get; set; }
        public long DailyTokenQuota { get; set; }
        public long TokensUsedToday { get; set; }
        public int DocumentCount { get; set; }

        public string Initials => GetInitials(FullName, Email);
    }

    private static string GetInitials(string? fullName, string? email)
    {
        var initials = string.Concat((fullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => part[0]))
            .ToUpperInvariant();

        return string.IsNullOrEmpty(initials)
            ? (email ?? string.Empty).Trim().FirstOrDefault().ToString().ToUpperInvariant()
            : initials;
    }
}

<style>
    .page-enter {
        animation: pageRise .42s ease both;
    }

    .detail-card,
    .detail-tabs-card {
        border-radius: 10px;
        border: 1px solid rgba(190, 196, 255, .14);
        background: rgba(18, 18, 31, .9);
    }

    .detail-card {
        padding: 1.25rem;
    }

    .detail-kicker { color: #72dcf2 !important; letter-spacing: .09em; }

    @@keyframes pageRise {
        from {
            opacity: 0;
            transform: translateY(14px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
